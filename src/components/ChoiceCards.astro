---
import { url } from '../lib/site';

export interface Choice {
  title: string;
  description?: string;
  href: string;
  meta?: string;
  icon?: 'book' | 'grid' | 'image' | 'film' | 'layout';
  /**
   * Optional visual preview. When present the card switches to a large vertical
   * layout: cover on top, then title, then description.
   *  - 'grid'  → a 3×2 mosaic of real thumbnails (needs 6; renders what it has)
   *  - 'cover' → a single full-bleed 16:9 image (e.g. a brand book first page)
   *  - 'brand' → the brand mark on an accent panel (fallback until a cover exists)
   */
  preview?:
    | { type: 'grid'; images: string[] }
    | { type: 'cover'; image: string }
    | { type: 'brand'; logo: string };
  disabled?: boolean;
}
interface Props {
  choices: Choice[];
}
const { choices } = Astro.props;
const hasPreview = choices.some((c) => c.preview);

const icons: Record<string, string> = {
  book: '<path d="M4 5a2 2 0 0 1 2-2h11v16H6a2 2 0 0 0-2 2z"/><path d="M17 3v16"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>',
  film: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 3v18M17 3v18M3 8h4M17 8h4M3 16h4M17 16h4"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
};

const arrow =
  '<path d="M5 12h14M13 6l6 6-6 6"/>';
---

<div class:list={['choices', { preview: hasPreview }]}>
  {
    choices.map((c) => (
      <a
        class:list={['choice reveal', { disabled: c.disabled, 'is-preview': !!c.preview }]}
        href={c.disabled ? undefined : url(c.href)}
        aria-disabled={c.disabled ? 'true' : undefined}
      >
        {c.preview ? (
          <>
            <span class="choice-cover" aria-hidden="true">
              {c.preview.type === 'grid' ? (
                <span class="cp-grid">
                  {c.preview.images.slice(0, 6).map((src) => (
                    <img src={url(src)} alt="" loading="lazy" />
                  ))}
                </span>
              ) : c.preview.type === 'cover' ? (
                <img class="cp-cover" src={url(c.preview.image)} alt="" loading="lazy" />
              ) : (
                <span class="cp-brand">
                  <img src={url(c.preview.logo)} alt="" loading="lazy" />
                </span>
              )}
            </span>
            <span class="choice-info">
              <span class="choice-heading">
                <span class="choice-title">
                  {c.title}
                  {c.meta && <span class="choice-meta">{c.meta}</span>}
                </span>
                {!c.disabled && (
                  <span class="choice-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
                  </span>
                )}
              </span>
              {c.description && <span class="choice-desc muted">{c.description}</span>}
            </span>
          </>
        ) : (
          <>
            <span class="choice-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.icon ?? 'grid']} />
            </span>
            <span class="choice-body">
              <span class="choice-title">
                {c.title}
                {c.meta && <span class="choice-meta">{c.meta}</span>}
              </span>
              {c.description && <span class="choice-desc muted">{c.description}</span>}
            </span>
            {!c.disabled && (
              <span class="choice-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
              </span>
            )}
          </>
        )}
      </a>
    ))
  }
</div>

<style>
  .choices {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  /* Preview pages: two large cards fill the row; a lone card is capped + centered. */
  .choices.preview {
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  .choices.preview .choice:only-child {
    max-width: 640px;
    margin: 0 auto;
  }

  .choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 26px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015));
    border: 1px solid var(--border);
    overflow: hidden;
    transition: transform 0.3s var(--ease-expo), border-color 0.3s, background 0.3s;
  }
  .choice::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px 200px at 15% 0%, var(--accent-glow), transparent 70%);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }
  .choice:not(.disabled):hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
  }
  .choice:not(.disabled):hover::after {
    opacity: 1;
  }
  .choice.disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* ---- Vertical media card (has a preview) ---- */
  .choice.is-preview {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
  }
  .choice-cover {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-elev-2);
    border-bottom: 1px solid var(--border);
  }
  .choice-cover img,
  .cp-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease-expo);
  }
  .choice.is-preview:not(.disabled):hover .choice-cover img {
    transform: scale(1.035);
  }
  .cp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 3px;
    width: 100%;
    height: 100%;
  }
  .cp-brand {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 50% 34%, color-mix(in srgb, var(--accent) 34%, transparent), transparent 66%),
      var(--bg-elev-2);
  }
  .cp-brand img {
    max-width: 46%;
    max-height: 56%;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.55));
    transition: none;
  }
  .choice-info {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 18px 22px 22px;
  }
  .choice-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* ---- Horizontal icon card (no preview) ---- */
  .choice-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .choice-icon svg {
    width: 26px;
    height: 26px;
  }
  .choice-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  /* ---- Shared text bits ---- */
  .choice-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.28rem;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .choice-meta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--fg-muted);
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .choice-desc {
    font-size: 0.94rem;
  }
  .choice-arrow {
    margin-left: auto;
    color: var(--fg-dim);
    transition: transform 0.3s var(--ease-expo), color 0.3s;
  }
  .choice-arrow svg {
    width: 22px;
    height: 22px;
  }
  .choice:not(.disabled):hover .choice-arrow {
    color: var(--accent);
    transform: translateX(5px);
  }
</style>
