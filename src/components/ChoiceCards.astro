---
import { url } from '../lib/site';

export interface Choice {
  title: string;
  description?: string;
  href: string;
  meta?: string;
  icon?: 'book' | 'grid' | 'image' | 'film' | 'layout';
  /**
   * Optional visual preview shown in place of the flat icon.
   *  - 'grid'  → a mini gallery of real thumbnails (needs 4+ images, else falls to a single cover)
   *  - 'brand' → the brand mark on an accent panel
   */
  preview?: { type: 'grid'; images: string[] } | { type: 'brand'; logo: string };
  disabled?: boolean;
}
interface Props {
  choices: Choice[];
}
const { choices } = Astro.props;

const icons: Record<string, string> = {
  book: '<path d="M4 5a2 2 0 0 1 2-2h11v16H6a2 2 0 0 0-2 2z"/><path d="M17 3v16"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>',
  film: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 3v18M17 3v18M3 8h4M17 8h4M3 16h4M17 16h4"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
};
---

<div class="choices">
  {
    choices.map((c) => (
      <a
        class:list={['choice reveal', { disabled: c.disabled }]}
        href={c.disabled ? undefined : url(c.href)}
        aria-disabled={c.disabled ? 'true' : undefined}
      >
        {c.preview ? (
          <span class="choice-preview" aria-hidden="true">
            {c.preview.type === 'grid' && c.preview.images.length >= 4 ? (
              <span class="cp-grid">
                {c.preview.images.slice(0, 4).map((src) => (
                  <img src={url(src)} alt="" loading="lazy" />
                ))}
              </span>
            ) : c.preview.type === 'grid' ? (
              <img class="cp-cover" src={url(c.preview.images[0])} alt="" loading="lazy" />
            ) : (
              <span class="cp-brand">
                <img src={url(c.preview.logo)} alt="" loading="lazy" />
              </span>
            )}
          </span>
        ) : (
          <span class="choice-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.icon ?? 'grid']} />
          </span>
        )}
        <span class="choice-body">
          <span class="choice-title">
            {c.title}
            {c.meta && <span class="choice-meta">{c.meta}</span>}
          </span>
          {c.description && <span class="choice-desc muted">{c.description}</span>}
        </span>
        {!c.disabled && (
          <span class="choice-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        )}
      </a>
    ))
  }
</div>

<style>
  .choices {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 26px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015));
    border: 1px solid var(--border);
    overflow: hidden;
    transition: transform 0.3s var(--ease-expo), border-color 0.3s, background 0.3s;
  }
  .choice::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px 200px at 15% 0%, var(--accent-glow), transparent 70%);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }
  .choice:not(.disabled):hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
  }
  .choice:not(.disabled):hover::after {
    opacity: 1;
  }
  .choice.disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .choice-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .choice-icon svg {
    width: 26px;
    height: 26px;
  }
  /* Visual preview (replaces the icon) */
  .choice-preview {
    flex: none;
    width: 116px;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elev-2);
    transition: transform 0.3s var(--ease-expo), border-color 0.3s;
  }
  .choice:not(.disabled):hover .choice-preview {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .cp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    width: 100%;
    height: 100%;
  }
  .cp-grid img,
  .cp-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cp-brand {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 50% 32%, color-mix(in srgb, var(--accent) 34%, transparent), transparent 68%),
      var(--bg-elev-2);
  }
  .cp-brand img {
    max-width: 62%;
    max-height: 58%;
    object-fit: contain;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.55));
  }
  @media (max-width: 400px) {
    .choice-preview {
      width: 92px;
    }
  }
  .choice-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .choice-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.28rem;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .choice-meta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--fg-muted);
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .choice-desc {
    font-size: 0.94rem;
  }
  .choice-arrow {
    margin-left: auto;
    color: var(--fg-dim);
    transition: transform 0.3s var(--ease-expo), color 0.3s;
  }
  .choice-arrow svg {
    width: 22px;
    height: 22px;
  }
  .choice:not(.disabled):hover .choice-arrow {
    color: var(--accent);
    transform: translateX(5px);
  }
</style>
