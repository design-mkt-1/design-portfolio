---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../lib/site';
import { thumbFor, thumbDims } from '../lib/thumbs';
import type { StoreGroup } from '../lib/store';

interface Props {
  groups: StoreGroup[];
  alt: string;
}
const { groups, alt } = Astro.props;
const single = groups.length === 1;

// Cache-bust by content length so re-uploaded screenshots aren't served stale.
function bust(path: string): string {
  let v = '';
  try {
    v = String(statSync(join(process.cwd(), 'public', path)).size);
  } catch {
    /* missing — leave unversioned */
  }
  return url(path) + (v ? `?v=${v}` : '');
}

// Assign a running index so each tile maps into the flat lightbox list. Each
// "copy" is the real set of frames followed by a delimiter; we render several
// copies so the forward loop stays filled on wide screens.
let counter = 0;
const rendered = groups.map((g) => {
  // marquee frames use generated thumbnails; the lightbox opens the original
  const items = g.images.map((src) => {
    const thumb = thumbFor(src)!;
    return { src: bust(src), thumb: url(thumb), dims: thumbDims(thumb), index: counter++ };
  });
  const copies = Math.max(6, Math.ceil(36 / (items.length + 1)));
  return { key: g.key, label: g.label, items, copies };
});
const flat = rendered.flatMap((g) => g.items.map((it) => ({ src: it.src, label: g.label })));
---

<div class="store">
  {
    rendered.map((g) => (
      <section class="store-group">
        {!single && (
          <div class="group-head reveal">
            <h2>{g.label}</h2>
            <span class="group-count muted">{g.items.length}</span>
          </div>
        )}
        <div class="marquee reveal" data-copies={g.copies}>
          <div class="mtrack">
            {Array.from({ length: g.copies }).map(() => (
              <>
                {g.items.map((it) => (
                  <button class="shot" data-index={it.index} aria-label={`${alt} — ${g.label}`} aria-haspopup="dialog">
                    <img src={it.thumb} alt="" width={it.dims?.w} height={it.dims?.h} loading="lazy" decoding="async" draggable="false" />
                  </button>
                ))}
                <span class="delim" aria-hidden="true" />
              </>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</div>

<script type="application/json" id="store-data" set:html={JSON.stringify(flat)} />

<div class="slb" id="store-lightbox" role="dialog" aria-modal="true" aria-label="Store screenshot" hidden>
  <button class="slb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="slb-nav slb-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="slb-nav slb-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>
  <div class="slb-scroll"><img id="slb-img" src="" alt="Store screenshot" /></div>
</div>

<script>
  import { createLightbox } from '../lib/lightbox';

  const data: { src: string; label: string }[] = JSON.parse(
    document.getElementById('store-data')?.textContent || '[]',
  );
  const lb = document.getElementById('store-lightbox')!;
  const img = document.getElementById('slb-img') as HTMLImageElement;
  const scroll = lb.querySelector('.slb-scroll') as HTMLElement;

  const ctrl = createLightbox({
    root: lb,
    count: data.length,
    closeSelector: '.slb-close',
    prevSelector: '.slb-prev',
    nextSelector: '.slb-next',
    backdropCloses: (t) => (t as HTMLElement)?.classList?.contains('slb-scroll'),
    onShow(i) {
      img.src = data[i].src;
      img.alt = data[i].label;
      scroll.scrollTop = 0;
    },
    onClose() {
      img.src = '';
    },
  });

  // JS-driven marquee: auto-scroll, pause on hover, drag/swipe to scroll freely.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.marquee').forEach((m) => {
    const track = m.querySelector<HTMLElement>('.mtrack')!;
    const copies = Number(m.dataset.copies) || 6;
    let loopW = 0; // width of one copy (set of frames + delimiter)
    const measure = () => {
      const w = track.scrollWidth / copies;
      if (w) loopW = w;
    };
    measure();
    window.addEventListener('load', measure);
    window.addEventListener('resize', measure);
    track.querySelectorAll('img').forEach((im) => im.addEventListener('load', measure, { once: true }));

    // Bounded-forward loop: frame 1 is the hard left edge (swipe-left stops
    // there); after the last frame + delimiter, wrap by one copy → back to
    // frame 1, seamlessly (copies are identical).
    const normalize = () => {
      if (!loopW) return;
      while (m.scrollLeft >= loopW) m.scrollLeft -= loopW;
      if (m.scrollLeft < 0) m.scrollLeft = 0;
    };

    let hovering = false;
    let dragging = false;
    let touching = false;
    function frame() {
      if (!reduce && !hovering && !dragging && !touching) m.scrollLeft += 0.5;
      if (!dragging && !touching) normalize();
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    m.addEventListener('mouseenter', () => (hovering = true));
    m.addEventListener('mouseleave', () => (hovering = false));
    m.addEventListener('touchstart', () => {
      touching = true;
      moved = 0;
    }, { passive: true });
    m.addEventListener('touchend', () => {
      touching = false;
      normalize();
    });

    // Mouse drag-to-scroll via window listeners (no pointer capture, so the
    // subsequent click still targets the tile). Touch uses native scrolling.
    let startX = 0;
    let startLeft = 0;
    let moved = 0;
    const onMove = (e: PointerEvent) => {
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      m.scrollLeft = Math.max(0, startLeft - dx); // hard stop at frame 1
    };
    const onUp = () => {
      dragging = false;
      m.classList.remove('grabbing');
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      normalize();
    };
    m.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startLeft = m.scrollLeft;
      m.classList.add('grabbing');
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
    });

    // Open the lightbox on a tap/click — unless the pointer was dragged.
    m.addEventListener('click', (e) => {
      if (moved > 6) {
        e.preventDefault();
        e.stopPropagation();
        moved = 0;
        return;
      }
      const shot = (e.target as HTMLElement).closest<HTMLElement>('.shot');
      if (shot?.dataset.index) ctrl.open(Number(shot.dataset.index));
    });
  });
</script>

<style>
  .store {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .group-head h2 {
    font-size: 1.4rem;
  }
  .group-count {
    font-size: 0.85rem;
  }

  /* Continuous marquee — auto-scrolls (JS), pause on hover, drag/swipe to scroll.
     Vertical padding gives the hover gold-glow room so it isn't clipped. */
  .marquee {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 30px 0;
    cursor: grab;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* soft edge fade on desktop only — kept subtle so frames don't feel cropped */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent);
  }
  /* Mobile: full-bleed — the strip escapes the page padding and runs edge to
     edge with no fade, so frames read as flowing off the screen instead of
     being squeezed into a masked box. */
  @media (max-width: 640px) {
    .marquee {
      margin-inline: -24px;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  .marquee::-webkit-scrollbar {
    display: none;
  }
  .marquee.grabbing {
    cursor: grabbing;
  }
  .mtrack {
    display: flex;
    gap: 16px;
    width: max-content;
  }
  .shot {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: none;
    cursor: inherit;
    line-height: 0;
    border-radius: 20px;
  }
  .shot img {
    height: clamp(360px, 56vh, 560px);
    width: auto;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    pointer-events: none; /* clicks + drag handled on .marquee */
    user-select: none;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .shot:hover img {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow:
      0 0 0 1.5px color-mix(in srgb, var(--accent) 50%, transparent),
      0 0 18px color-mix(in srgb, var(--accent) 40%, transparent),
      0 18px 45px rgba(0, 0, 0, 0.5);
  }
  /* End-of-set delimiter before the loop repeats with the first frame. */
  .delim {
    flex: 0 0 auto;
    align-self: center;
    display: grid;
    place-items: center;
    width: 44px;
    height: clamp(360px, 56vh, 560px);
    pointer-events: none;
  }
  .delim::before {
    content: '';
    width: 2px;
    height: 44%;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--accent) 55%, var(--fg-dim)) 50%,
      transparent
    );
  }

  /* Lightbox — scrollable full-length view */
  .slb[hidden] {
    display: none;
  }
  .slb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 9, 0.92);
    backdrop-filter: blur(10px);
    animation: sfade 0.2s var(--ease-expo);
  }
  @keyframes sfade {
    from {
      opacity: 0;
    }
  }
  .slb-scroll {
    position: absolute;
    inset: 0;
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 40px 20px 60px;
  }
  .slb-scroll img {
    height: fit-content;
    max-width: min(92vw, 460px);
    width: auto;
    border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--border);
  }
  .slb-close,
  .slb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.75);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .slb-close:hover,
  .slb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .slb-close {
    top: 18px;
    right: 18px;
  }
  .slb-close svg,
  .slb-nav svg {
    width: 22px;
    height: 22px;
  }
  .slb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .slb-prev {
    left: 18px;
  }
  .slb-next {
    right: 18px;
  }
  @media (max-width: 640px) {
    .slb-nav {
      top: auto;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      transform: none;
    }
    .slb-prev {
      left: 28%;
    }
    .slb-next {
      right: 28%;
    }
  }
</style>
