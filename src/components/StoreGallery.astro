---
import { url } from '../lib/site';
import type { StoreGroup } from '../lib/store';

interface Props {
  groups: StoreGroup[];
  alt: string;
}
const { groups, alt } = Astro.props;

// Assign a running index so each tile maps into the flat lightbox list.
let counter = 0;
const rendered = groups.map((g) => ({
  key: g.key,
  label: g.label,
  items: g.images.map((src) => ({ src: url(src), index: counter++ })),
}));
const flat = rendered.flatMap((g) => g.items.map((it) => ({ src: it.src, label: g.label })));
---

<div class="store">
  {
    rendered.map((g) => (
      <section class="store-group">
        <div class="group-head reveal">
          <h2>{g.label}</h2>
          <span class="group-count muted">{g.items.length}</span>
        </div>
        <div class="carousel-wrap">
          <button class="car-nav car-prev" aria-label="Scroll left" data-group={g.key}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <div class="carousel reveal" data-group={g.key}>
            {g.items.map((it) => (
              <button class="shot" data-index={it.index} aria-haspopup="dialog">
                <img src={it.src} alt={`${alt} — ${g.label}`} loading="lazy" />
              </button>
            ))}
          </div>
          <button class="car-nav car-next" aria-label="Scroll right" data-group={g.key}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
      </section>
    ))
  }
</div>

<script type="application/json" id="store-data" set:html={JSON.stringify(flat)} />

<div class="slb" id="store-lightbox" role="dialog" aria-modal="true" aria-label="Store screenshot" hidden>
  <button class="slb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="slb-nav slb-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="slb-nav slb-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>
  <div class="slb-scroll"><img id="slb-img" src="" alt="Store screenshot" /></div>
</div>

<script>
  const data: { src: string; label: string }[] = JSON.parse(
    document.getElementById('store-data')?.textContent || '[]',
  );
  const lb = document.getElementById('store-lightbox')!;
  const img = document.getElementById('slb-img') as HTMLImageElement;
  const scroll = lb.querySelector('.slb-scroll') as HTMLElement;
  let idx = 0;
  let lastFocus: HTMLElement | null = null;

  const navBtns = [lb.querySelector('.slb-prev'), lb.querySelector('.slb-next')];
  if (data.length <= 1) navBtns.forEach((b) => b && ((b as HTMLElement).style.display = 'none'));

  function show(i: number) {
    idx = (i + data.length) % data.length;
    img.src = data[idx].src;
    img.alt = data[idx].label;
    scroll.scrollTop = 0;
  }
  function open(i: number) {
    lastFocus = document.activeElement as HTMLElement;
    show(i);
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    (lb.querySelector('.slb-close') as HTMLElement)?.focus();
  }
  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    img.src = '';
    lastFocus?.focus();
  }
  function trapFocus(e: KeyboardEvent) {
    const f = Array.from(lb.querySelectorAll<HTMLElement>('button')).filter(
      (el) => !el.hasAttribute('disabled') && el.offsetParent !== null,
    );
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    const a = document.activeElement as HTMLElement;
    if (e.shiftKey && (a === first || !lb.contains(a))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && a === last) {
      e.preventDefault();
      first.focus();
    }
  }

  document.querySelectorAll<HTMLElement>('.shot').forEach((s) => {
    s.addEventListener('click', () => open(Number(s.dataset.index)));
  });
  // Carousel arrows scroll their row by ~one image width.
  document.querySelectorAll<HTMLElement>('.car-nav').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.parentElement!.querySelector<HTMLElement>('.carousel')!;
      const dir = btn.classList.contains('car-prev') ? -1 : 1;
      row.scrollBy({ left: dir * Math.min(row.clientWidth * 0.8, 420), behavior: 'smooth' });
    });
  });
  lb.querySelector('.slb-close')?.addEventListener('click', close);
  lb.querySelector('.slb-prev')?.addEventListener('click', () => show(idx - 1));
  lb.querySelector('.slb-next')?.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb || (e.target as HTMLElement).classList.contains('slb-scroll')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'Tab') trapFocus(e);
    else if (data.length <= 1) return;
    else if (e.key === 'ArrowRight') show(idx + 1);
    else if (e.key === 'ArrowLeft') show(idx - 1);
  });
</script>

<style>
  .store {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .group-head h2 {
    font-size: 1.4rem;
  }
  .group-count {
    font-size: 0.85rem;
  }
  .carousel-wrap {
    position: relative;
  }
  .carousel {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 16px;
    scrollbar-width: thin;
  }
  .shot {
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 20px;
    overflow: hidden;
    line-height: 0;
    transition: transform 0.3s var(--ease-expo);
  }
  .shot img {
    height: clamp(360px, 56vh, 560px);
    width: auto;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .shot:hover {
    transform: translateY(-4px);
  }
  .shot:hover img {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
  }
  .car-nav {
    position: absolute;
    top: calc(50% - 8px);
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.82);
    border: 1px solid var(--border);
    color: var(--fg);
    backdrop-filter: blur(6px);
    transition: background 0.2s, border-color 0.2s;
  }
  .car-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .car-nav svg {
    width: 22px;
    height: 22px;
  }
  .car-prev {
    left: -6px;
  }
  .car-next {
    right: -6px;
  }
  @media (max-width: 640px) {
    .car-nav {
      display: none; /* touch users swipe */
    }
  }

  /* Lightbox — scrollable full-length view */
  .slb[hidden] {
    display: none;
  }
  .slb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 9, 0.92);
    backdrop-filter: blur(10px);
    animation: sfade 0.2s var(--ease-expo);
  }
  @keyframes sfade {
    from {
      opacity: 0;
    }
  }
  .slb-scroll {
    position: absolute;
    inset: 0;
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 40px 20px 60px;
  }
  .slb-scroll img {
    height: fit-content;
    max-width: min(92vw, 460px);
    width: auto;
    border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--border);
  }
  .slb-close,
  .slb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.75);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .slb-close:hover,
  .slb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .slb-close {
    top: 18px;
    right: 18px;
  }
  .slb-close svg,
  .slb-nav svg {
    width: 22px;
    height: 22px;
  }
  .slb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .slb-prev {
    left: 18px;
  }
  .slb-next {
    right: 18px;
  }
  @media (max-width: 640px) {
    .slb-nav {
      top: auto;
      bottom: 18px;
      transform: none;
    }
    .slb-prev {
      left: 28%;
    }
    .slb-next {
      right: 28%;
    }
  }
</style>
