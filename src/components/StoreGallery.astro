---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../lib/site';
import type { StoreGroup } from '../lib/store';

interface Props {
  groups: StoreGroup[];
  alt: string;
}
const { groups, alt } = Astro.props;
const single = groups.length === 1;

// Cache-bust by content length so re-uploaded screenshots aren't served stale.
function bust(path: string): string {
  let v = '';
  try {
    v = String(statSync(join(process.cwd(), 'public', path)).size);
  } catch {
    /* missing — leave unversioned */
  }
  return url(path) + (v ? `?v=${v}` : '');
}

// Assign a running index so each tile maps into the flat lightbox list, and
// build a repeated "loop" long enough for a seamless continuous marquee.
let counter = 0;
const rendered = groups.map((g) => {
  const items = g.images.map((src) => ({ src: bust(src), index: counter++ }));
  const loop = [...items];
  while (loop.length < 16) loop.push(...items);
  return { key: g.key, label: g.label, items, loop, dur: `${loop.length * 3.2}s` };
});
const flat = rendered.flatMap((g) => g.items.map((it) => ({ src: it.src, label: g.label })));
---

<div class="store">
  {
    rendered.map((g) => (
      <section class="store-group">
        {!single && (
          <div class="group-head reveal">
            <h2>{g.label}</h2>
            <span class="group-count muted">{g.items.length}</span>
          </div>
        )}
        <div class="marquee reveal">
          <div class="mtrack" style={`--dur:${g.dur}`}>
            {[...g.loop, ...g.loop].map((it) => (
              <button class="shot" data-index={it.index} aria-label={`${alt} — ${g.label}`} aria-haspopup="dialog">
                <img src={it.src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</div>

<script type="application/json" id="store-data" set:html={JSON.stringify(flat)} />

<div class="slb" id="store-lightbox" role="dialog" aria-modal="true" aria-label="Store screenshot" hidden>
  <button class="slb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="slb-nav slb-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="slb-nav slb-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>
  <div class="slb-scroll"><img id="slb-img" src="" alt="Store screenshot" /></div>
</div>

<script>
  const data: { src: string; label: string }[] = JSON.parse(
    document.getElementById('store-data')?.textContent || '[]',
  );
  const lb = document.getElementById('store-lightbox')!;
  const img = document.getElementById('slb-img') as HTMLImageElement;
  const scroll = lb.querySelector('.slb-scroll') as HTMLElement;
  let idx = 0;
  let lastFocus: HTMLElement | null = null;

  const navBtns = [lb.querySelector('.slb-prev'), lb.querySelector('.slb-next')];
  if (data.length <= 1) navBtns.forEach((b) => b && ((b as HTMLElement).style.display = 'none'));

  function show(i: number) {
    idx = (i + data.length) % data.length;
    img.src = data[idx].src;
    img.alt = data[idx].label;
    scroll.scrollTop = 0;
  }
  function open(i: number) {
    lastFocus = document.activeElement as HTMLElement;
    show(i);
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    (lb.querySelector('.slb-close') as HTMLElement)?.focus();
  }
  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    img.src = '';
    lastFocus?.focus();
  }
  function trapFocus(e: KeyboardEvent) {
    const f = Array.from(lb.querySelectorAll<HTMLElement>('button')).filter(
      (el) => !el.hasAttribute('disabled') && el.offsetParent !== null,
    );
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    const a = document.activeElement as HTMLElement;
    if (e.shiftKey && (a === first || !lb.contains(a))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && a === last) {
      e.preventDefault();
      first.focus();
    }
  }

  // Delegated click so marquee clones open the lightbox too.
  document.querySelectorAll<HTMLElement>('.mtrack').forEach((track) => {
    track.addEventListener('click', (e) => {
      const shot = (e.target as HTMLElement).closest<HTMLElement>('.shot');
      if (shot?.dataset.index) open(Number(shot.dataset.index));
    });
  });
  lb.querySelector('.slb-close')?.addEventListener('click', close);
  lb.querySelector('.slb-prev')?.addEventListener('click', () => show(idx - 1));
  lb.querySelector('.slb-next')?.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb || (e.target as HTMLElement).classList.contains('slb-scroll')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'Tab') trapFocus(e);
    else if (data.length <= 1) return;
    else if (e.key === 'ArrowRight') show(idx + 1);
    else if (e.key === 'ArrowLeft') show(idx - 1);
  });
</script>

<style>
  .store {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .group-head h2 {
    font-size: 1.4rem;
  }
  .group-count {
    font-size: 0.85rem;
  }

  /* Continuous marquee — full-bleed within the container, fades at the edges */
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .mtrack {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: marq var(--dur, 40s) linear infinite;
  }
  .marquee:hover .mtrack {
    animation-play-state: paused;
  }
  @keyframes marq {
    to {
      transform: translateX(-50%);
    }
  }
  .shot {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    line-height: 0;
    border-radius: 20px;
    transition: transform 0.3s var(--ease-expo);
  }
  .shot img {
    height: clamp(360px, 56vh, 560px);
    width: auto;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .shot:hover {
    transform: translateY(-4px);
  }
  .shot:hover img {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .mtrack {
      animation: none;
    }
  }

  /* Lightbox — scrollable full-length view */
  .slb[hidden] {
    display: none;
  }
  .slb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 9, 0.92);
    backdrop-filter: blur(10px);
    animation: sfade 0.2s var(--ease-expo);
  }
  @keyframes sfade {
    from {
      opacity: 0;
    }
  }
  .slb-scroll {
    position: absolute;
    inset: 0;
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 40px 20px 60px;
  }
  .slb-scroll img {
    height: fit-content;
    max-width: min(92vw, 460px);
    width: auto;
    border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--border);
  }
  .slb-close,
  .slb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.75);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .slb-close:hover,
  .slb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .slb-close {
    top: 18px;
    right: 18px;
  }
  .slb-close svg,
  .slb-nav svg {
    width: 22px;
    height: 22px;
  }
  .slb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .slb-prev {
    left: 18px;
  }
  .slb-next {
    right: 18px;
  }
  @media (max-width: 640px) {
    .slb-nav {
      top: auto;
      bottom: 18px;
      transform: none;
    }
    .slb-prev {
      left: 28%;
    }
    .slb-next {
      right: 28%;
    }
  }
</style>
