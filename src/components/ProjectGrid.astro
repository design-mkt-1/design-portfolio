---
import { url } from '../lib/site';
import { projects, type Project } from '../data/projects';
import { hasPortfolio, hasBrandbook, assetExists, projectEntry } from '../lib/portfolio';
import Flag from './Flag.astro';

function tags(p: Project): string[] {
  const t: string[] = [];
  if (hasBrandbook(p)) t.push('Brandbook');
  if (hasPortfolio(p)) t.push('Portfolio');
  return t;
}
---

<div class="grid">
  {
    projects.map((p) => (
      <a class="card reveal" href={url(projectEntry(p))} style={`--card-accent:${p.accent ?? 'var(--accent)'}`}>
        <span class="glow" aria-hidden="true" />
        <span class="logo-wrap">
          {assetExists(p.logo) ? (
            <img src={url(p.logo)} alt={`${p.name} logo`} loading="lazy" />
          ) : (
            <span class="logo-fallback">{p.name}</span>
          )}
        </span>
        <span class="meta">
          <span class="meta-main">
            <span class="name">{p.name}</span>
            {p.geo && (
              <span class="geo">
                <Flag code={p.geo.code} />
                <span class="geo-label">{p.geo.label}</span>
              </span>
            )}
          </span>
          <span class="tags">
            {tags(p).map((t) => (
              <span class="tag">{t}</span>
            ))}
          </span>
        </span>
      </a>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
    min-height: 240px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    border: 1px solid var(--border);
    overflow: hidden;
    transition: transform 0.35s var(--ease-expo), border-color 0.35s;
  }
  .glow {
    position: absolute;
    inset: -1px;
    background: radial-gradient(500px 240px at 50% -10%, color-mix(in srgb, var(--card-accent) 30%, transparent), transparent 65%);
    opacity: 0.5;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--card-accent) 55%, transparent);
  }
  .card:hover .glow {
    opacity: 1;
  }
  .logo-wrap {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 12px;
  }
  .logo-wrap img {
    max-height: 92px;
    max-width: 80%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.4));
  }
  /* Shown until a real logo file is uploaded — reads as an intentional wordmark. */
  .logo-fallback {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: 0.01em;
    text-align: center;
    color: color-mix(in srgb, var(--card-accent) 70%, var(--fg));
  }
  .meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    position: relative;
  }
  .meta-main {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .geo {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--fg-muted);
  }
  .geo-label {
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .tag {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
  }
</style>
