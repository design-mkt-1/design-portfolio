---
import { url } from '../lib/site';
import { DEVICE_ORDER, DEVICE_LABEL, type LandingItem } from '../data/projects';

interface Props {
  items: LandingItem[];
  alt: string;
}
const { items, alt } = Astro.props;

// Resolve to final URLs so the client script is base-safe. Mobile first.
const payload = items.map((item) => ({
  title: item.title,
  devices: DEVICE_ORDER.filter((d) => item[d]).map((d) => ({
    key: d,
    label: DEVICE_LABEL[d],
    src: url(item[d]!),
  })),
}));
---

<div class="lg-grid">
  {
    payload.map((item, i) => {
      const thumb = item.devices[0]; // mobile first
      return (
        <button class="lg-item reveal" data-index={i} aria-haspopup="dialog">
          <span class="phone">
            <img src={thumb.src} alt={`${alt} ${item.title} (${thumb.label})`} loading="lazy" />
            <span class="zoom" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" /></svg>
            </span>
          </span>
          <span class="lg-meta">
            <span class="lg-title">{item.title}</span>
            <span class="lg-devices">
              {item.devices.map((d) => (
                <span class="chip">{d.label}</span>
              ))}
            </span>
          </span>
        </button>
      );
    })
  }
</div>

<script type="application/json" id="landing-data" set:html={JSON.stringify(payload)} />

<div class="lgb" id="landing-lightbox" role="dialog" aria-modal="true" aria-label="Landing viewer" data-device="mobile" hidden>
  <button class="lgb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="lgb-nav lgb-prev" aria-label="Previous landing">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="lgb-nav lgb-next" aria-label="Next landing">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>

  <div class="lgb-bar">
    <span class="lgb-title" id="lgb-title"></span>
    <div class="lgb-toggle" role="tablist" aria-label="Device">
      <button class="dev" data-device="mobile" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="7" y="3" width="10" height="18" rx="2" /><path d="M11 18h2" /></svg>
        Mobile
      </button>
      <button class="dev" data-device="desktop" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
        Desktop
      </button>
    </div>
  </div>

  <div class="lgb-scroll"><img id="lgb-img" src="" alt="Landing preview" /></div>
</div>

<script>
  interface Dev { key: 'mobile' | 'desktop'; label: string; src: string }
  interface Item { title: string; devices: Dev[] }
  const data: Item[] = JSON.parse(document.getElementById('landing-data')?.textContent || '[]');
  const lb = document.getElementById('landing-lightbox')!;
  const img = document.getElementById('lgb-img') as HTMLImageElement;
  const titleEl = document.getElementById('lgb-title')!;
  const scroll = lb.querySelector('.lgb-scroll') as HTMLElement;
  const devBtns = Array.from(lb.querySelectorAll<HTMLButtonElement>('.dev'));

  let idx = 0;
  let device: 'mobile' | 'desktop' = 'mobile';
  let lastFocus: HTMLElement | null = null;

  function current() {
    return data[idx];
  }
  function pick(dev: 'mobile' | 'desktop') {
    const item = current();
    const found = item.devices.find((d) => d.key === dev) || item.devices[0];
    device = found.key;
    img.src = found.src;
    img.alt = `${item.title} (${found.label})`;
    lb.setAttribute('data-device', device);
    scroll.scrollTop = 0;
    // toggle button states: enable only available devices, mark active
    devBtns.forEach((b) => {
      const has = item.devices.some((d) => d.key === b.dataset.device);
      b.disabled = !has;
      b.classList.toggle('active', b.dataset.device === device);
      b.setAttribute('aria-selected', b.dataset.device === device ? 'true' : 'false');
    });
  }
  function show(i: number, preferMobile = true) {
    idx = (i + data.length) % data.length;
    titleEl.textContent = current().title;
    pick(preferMobile ? 'mobile' : device);
  }
  function open(i: number) {
    lastFocus = document.activeElement as HTMLElement;
    show(i);
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    (lb.querySelector('.lgb-close') as HTMLElement)?.focus();
  }
  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    img.src = '';
    lastFocus?.focus();
  }

  document.querySelectorAll<HTMLElement>('.lg-item').forEach((el) => {
    el.addEventListener('click', () => open(Number(el.dataset.index)));
  });
  devBtns.forEach((b) => b.addEventListener('click', () => !b.disabled && pick(b.dataset.device as 'mobile' | 'desktop')));
  lb.querySelector('.lgb-close')?.addEventListener('click', close);
  lb.querySelector('.lgb-prev')?.addEventListener('click', () => show(idx - 1));
  lb.querySelector('.lgb-next')?.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb || (e.target as HTMLElement).classList.contains('lgb-scroll')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') show(idx + 1);
    else if (e.key === 'ArrowLeft') show(idx - 1);
  });
</script>

<style>
  .lg-grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .lg-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    background: none;
    border: none;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }
  /* Mobile-first tile: portrait phone preview showing the top of the page */
  .phone {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition: transform 0.3s var(--ease-expo), border-color 0.3s, box-shadow 0.3s;
  }
  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .lg-item:hover .phone {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
  }
  .zoom {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(4px);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s, transform 0.3s var(--ease-expo);
  }
  .zoom svg {
    width: 17px;
    height: 17px;
  }
  .lg-item:hover .zoom {
    opacity: 1;
    transform: none;
  }
  .lg-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 4px;
  }
  .lg-title {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .lg-devices {
    display: flex;
    gap: 5px;
  }
  .chip {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--fg-muted);
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* Lightbox */
  .lgb[hidden] {
    display: none;
  }
  .lgb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 9, 0.92);
    backdrop-filter: blur(10px);
    animation: fade 0.2s var(--ease-expo);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lgb-scroll {
    position: absolute;
    inset: 74px 0 0;
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 30px 20px 50px;
  }
  .lgb-scroll img {
    width: auto;
    height: fit-content;
    border-radius: 14px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--border);
  }
  .lgb[data-device='mobile'] .lgb-scroll img {
    max-width: min(92vw, 420px);
  }
  .lgb[data-device='desktop'] .lgb-scroll img {
    max-width: min(94vw, 1040px);
  }

  .lgb-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 74px;
    border-bottom: 1px solid var(--border);
    background: rgba(11, 11, 18, 0.7);
  }
  .lgb-title {
    position: absolute;
    left: 74px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .lgb-toggle {
    display: flex;
    gap: 6px;
    padding: 5px;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .dev {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 999px;
    border: none;
    background: none;
    color: var(--fg-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }
  .dev svg {
    width: 17px;
    height: 17px;
  }
  .dev.active {
    background: var(--brand-gradient, var(--accent));
    color: #fff;
  }
  .dev:disabled {
    opacity: 0.32;
    cursor: not-allowed;
  }

  .lgb-close,
  .lgb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.75);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .lgb-close:hover,
  .lgb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .lgb-close {
    top: 15px;
    right: 18px;
  }
  .lgb-close svg,
  .lgb-nav svg {
    width: 21px;
    height: 21px;
  }
  .lgb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .lgb-prev {
    left: 18px;
  }
  .lgb-next {
    right: 18px;
  }
  @media (max-width: 640px) {
    .lgb-title {
      display: none;
    }
    .lgb-nav {
      top: auto;
      bottom: 18px;
      transform: none;
    }
    .lgb-prev {
      left: 28%;
    }
    .lgb-next {
      right: 28%;
    }
  }
</style>
