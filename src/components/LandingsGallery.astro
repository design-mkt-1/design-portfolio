---
import { url } from '../lib/site';

interface Props {
  images: string[];
  alt: string;
}
const { images, alt } = Astro.props;
const resolved = images.map((src) => url(src));
---

<div class="lg-grid">
  {
    resolved.map((src, i) => (
      <button class="lg-item reveal" data-src={src} data-index={i} aria-haspopup="dialog">
        <img src={src} alt={`${alt} landing ${i + 1}`} loading="lazy" />
        <span class="lg-zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" /></svg>
        </span>
      </button>
    ))
  }
</div>

<script type="application/json" id="landing-data" set:html={JSON.stringify(resolved)} />

<div class="lgb" id="landing-lightbox" role="dialog" aria-modal="true" aria-label="Landing viewer" hidden>
  <button class="lgb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="lgb-nav lgb-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="lgb-nav lgb-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>
  <div class="lgb-scroll"><img id="lgb-img" src="" alt="Landing preview" /></div>
</div>

<script>
  const data = JSON.parse(document.getElementById('landing-data')?.textContent || '[]') as string[];
  const lb = document.getElementById('landing-lightbox')!;
  const img = document.getElementById('lgb-img') as HTMLImageElement;
  let idx = 0;
  let lastFocus: HTMLElement | null = null;

  function show(i: number) {
    idx = (i + data.length) % data.length;
    img.src = data[idx];
    lb.querySelector('.lgb-scroll')!.scrollTop = 0;
  }
  function open(i: number) {
    lastFocus = document.activeElement as HTMLElement;
    show(i);
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    (lb.querySelector('.lgb-close') as HTMLElement)?.focus();
  }
  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    img.src = '';
    lastFocus?.focus();
  }

  document.querySelectorAll<HTMLElement>('.lg-item').forEach((el) => {
    el.addEventListener('click', () => open(Number(el.dataset.index)));
  });
  lb.querySelector('.lgb-close')?.addEventListener('click', close);
  lb.querySelector('.lgb-prev')?.addEventListener('click', () => show(idx - 1));
  lb.querySelector('.lgb-next')?.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb || (e.target as HTMLElement).classList.contains('lgb-scroll')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') show(idx + 1);
    else if (e.key === 'ArrowLeft') show(idx - 1);
  });
</script>

<style>
  .lg-grid {
    columns: 3 260px;
    column-gap: 18px;
  }
  .lg-item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 18px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
    cursor: pointer;
    break-inside: avoid;
    transition: transform 0.3s var(--ease-expo), border-color 0.3s, box-shadow 0.3s;
  }
  .lg-item img {
    width: 100%;
    display: block;
  }
  .lg-item:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
  }
  .lg-zoom {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(4px);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s, transform 0.3s var(--ease-expo);
  }
  .lg-zoom svg {
    width: 18px;
    height: 18px;
  }
  .lg-item:hover .lg-zoom {
    opacity: 1;
    transform: none;
  }

  .lgb[hidden] {
    display: none;
  }
  .lgb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 9, 0.9);
    backdrop-filter: blur(10px);
    animation: fade 0.2s var(--ease-expo);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lgb-scroll {
    position: absolute;
    inset: 0;
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 40px 20px;
  }
  .lgb-scroll img {
    width: auto;
    max-width: min(92vw, 900px);
    height: fit-content;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .lgb-close,
  .lgb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.75);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .lgb-close:hover,
  .lgb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .lgb-close {
    top: 20px;
    right: 20px;
  }
  .lgb-close svg,
  .lgb-nav svg {
    width: 22px;
    height: 22px;
  }
  .lgb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .lgb-prev {
    left: 18px;
  }
  .lgb-next {
    right: 18px;
  }
</style>
