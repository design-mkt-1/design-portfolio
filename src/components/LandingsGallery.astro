---
import { url } from '../lib/site';
import { thumbFor, thumbDims } from '../lib/thumbs';
import { DEVICE_ORDER, DEVICE_LABEL, type LandingItem } from '../data/projects';
import { stableAnalyticsId } from '../lib/analytics.mjs';

interface Props {
  items: LandingItem[];
  alt: string;
}
const { items, alt } = Astro.props;

// Resolve to final URLs so the client script is base-safe. Mobile first.
// The lightbox always gets originals; tiles get the generated thumbnails.
const payload = items.map((item) => ({
  title: item.title,
  devices: DEVICE_ORDER.filter((d) => item[d]).map((d) => ({
    key: d,
    label: DEVICE_LABEL[d],
    src: url(item[d]!),
  })),
}));
const tiles = items.map((item) => {
  const original = item.mobile ?? item.tablet ?? item.desktop;
  const thumb = thumbFor(original);
  return { src: url(thumb!), dims: thumbDims(thumb) };
});
---

<div class="lg-grid">
  {
    payload.map((item, i) => {
      const thumb = tiles[i];
      const analyticsId = stableAnalyticsId('landing', item.devices[0].src);
      return (
        <button
          class="lg-item reveal"
          data-index={i}
          aria-haspopup="dialog"
          data-analytics-event="select_content"
          data-analytics-id={analyticsId}
          data-analytics-location="landing_gallery"
          data-content-type="landing"
          data-content-id={analyticsId}
        >
          <span class="phone">
            <img
              src={thumb.src}
              alt={`${alt} ${item.title} (${item.devices[0].label})`}
              width={thumb.dims?.w}
              height={thumb.dims?.h}
              loading="lazy"
              decoding="async"
            />
            <span class="zoom" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" /></svg>
            </span>
          </span>
          <span class="lg-meta">
            <span class="lg-title">{item.title}</span>
            <span class="lg-devices">
              {item.devices.map((d) => (
                <span class="chip">{d.label}</span>
              ))}
            </span>
          </span>
        </button>
      );
    })
  }
</div>

<script type="application/json" id="landing-data" set:html={JSON.stringify(payload)} />

<div class="lgb" id="landing-lightbox" role="dialog" aria-modal="true" aria-label="Landing viewer" data-device="mobile" hidden>
  <button class="lgb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="lgb-nav lgb-prev" aria-label="Previous landing">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="lgb-nav lgb-next" aria-label="Next landing">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>

  <div class="lgb-bar">
    <span class="lgb-title" id="lgb-title"></span>
    <div class="lgb-toggle" role="tablist" aria-label="Device">
      <button class="dev" data-device="mobile" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="7" y="3" width="10" height="18" rx="2" /><path d="M11 18h2" /></svg>
        Mobile
      </button>
      <button class="dev" data-device="tablet" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M11 18h2" /></svg>
        Tablet
      </button>
      <button class="dev" data-device="desktop" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
        Desktop
      </button>
    </div>
  </div>

  <div class="lgb-scroll">
    <img id="lgb-img" src="" alt="Landing preview" />
    <span class="lgb-spin" id="lgb-spin" hidden aria-hidden="true"></span>
  </div>
</div>

<script>
  import { createLightbox } from '../lib/lightbox';

  type DeviceKey = 'mobile' | 'tablet' | 'desktop';
  interface Dev { key: DeviceKey; label: string; src: string }
  interface Item { title: string; devices: Dev[] }
  const data: Item[] = JSON.parse(document.getElementById('landing-data')?.textContent || '[]');
  const lb = document.getElementById('landing-lightbox')!;
  const img = document.getElementById('lgb-img') as HTMLImageElement;
  const titleEl = document.getElementById('lgb-title')!;
  const scroll = lb.querySelector('.lgb-scroll') as HTMLElement;
  const devBtns = Array.from(lb.querySelectorAll<HTMLButtonElement>('.dev'));

  let idx = 0;
  // The chosen device persists across prev/next; falls back per item when a
  // version is missing. Opening from the grid always starts on mobile.
  let device: DeviceKey = 'mobile';

  // The <img> keeps painting the PREVIOUS landing until a newly-assigned src
  // finishes downloading (seconds on mobile networks) — blank it immediately,
  // spin while the new file loads, and only swap in the decoded image.
  // The token guards against fast swipes racing each other.
  const spin = document.getElementById('lgb-spin')!;
  const BLANK = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
  let loadToken = 0;
  function loadInto(src: string) {
    const token = ++loadToken;
    img.src = BLANK;
    spin.hidden = false;
    const pre = new Image();
    pre.onload = () => {
      if (token !== loadToken) return;
      img.src = src;
      spin.hidden = true;
    };
    pre.onerror = () => {
      if (token === loadToken) spin.hidden = true;
    };
    pre.src = src;
  }

  function pick(dev: DeviceKey) {
    const item = data[idx];
    const found = item.devices.find((d) => d.key === dev) || item.devices[0];
    device = found.key;
    loadInto(found.src);
    img.alt = `${item.title} (${found.label})`;
    lb.setAttribute('data-device', device);
    scroll.scrollTop = 0;
    // toggle buttons: devices without a version are hidden entirely, the rest
    // mark the active one
    devBtns.forEach((b) => {
      const has = item.devices.some((d) => d.key === b.dataset.device);
      b.disabled = !has;
      b.hidden = !has;
      b.classList.toggle('active', b.dataset.device === device);
      b.setAttribute('aria-selected', b.dataset.device === device ? 'true' : 'false');
    });
  }

  const ctrl = createLightbox({
    root: lb,
    count: data.length,
    closeSelector: '.lgb-close',
    prevSelector: '.lgb-prev',
    nextSelector: '.lgb-next',
    swipe: { listen: scroll, el: () => img },
    backdropCloses: (t) => (t as HTMLElement)?.classList?.contains('lgb-scroll'),
    onShow(i) {
      idx = i;
      titleEl.textContent = data[idx].title;
      pick(device);
    },
    onClose() {
      img.src = '';
    },
  });

  document.querySelectorAll<HTMLElement>('.lg-item').forEach((el) => {
    el.addEventListener('click', () => {
      device = 'mobile';
      ctrl.open(Number(el.dataset.index));
    });
  });
  devBtns.forEach((b) => b.addEventListener('click', () => !b.disabled && pick(b.dataset.device as DeviceKey)));

  // deep link from the /work overviews: #open-<n> opens that landing directly
  const lgItems = document.querySelectorAll<HTMLElement>('.lg-item');
  const deep = location.hash.match(/^#open-(\d+)$/);
  if (deep && lgItems.length) {
    const i = Math.min(lgItems.length - 1, Math.max(0, Number(deep[1])));
    lgItems[i]?.scrollIntoView({ block: 'center' });
    device = 'mobile';
    requestAnimationFrame(() => ctrl.open(i));
  }
</script>

<style>
  .lg-grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .lg-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    background: none;
    border: none;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }
  /* Mobile-first tile: portrait phone preview showing the top of the page */
  .phone {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition: transform 0.3s var(--ease-expo), border-color 0.3s, box-shadow 0.3s;
  }
  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .lg-item:hover .phone {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
  }
  .zoom {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(4px);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s, transform 0.3s var(--ease-expo);
  }
  .zoom svg {
    width: 17px;
    height: 17px;
  }
  .lg-item:hover .zoom {
    opacity: 1;
    transform: none;
  }
  /* Title above, device chips below — long campaign names wrap freely without
     colliding with the chips (they used to share one cramped row). */
  .lg-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    padding: 0 4px;
  }
  /* Titles always occupy exactly two lines (short ones reserve the space,
     long ones clamp with an ellipsis), so the device chips line up in one
     row across every tile. */
  .lg-title {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.35;
    min-height: 2.7em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lg-devices {
    display: flex;
    flex-wrap: nowrap;
    gap: 5px;
  }
  .chip {
    white-space: nowrap;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--fg-muted);
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* Lightbox */
  .lgb[hidden] {
    display: none;
  }
  .lgb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 9, 0.92);
    backdrop-filter: blur(10px);
    animation: fade 0.2s var(--ease-expo);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lgb-scroll {
    position: absolute;
    inset: 74px 0 0;
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 30px 20px 50px;
  }
  /* loading spinner while the next landing downloads (the image itself is
     blanked instantly so the previous one never lingers) */
  .lgb-spin {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.16);
    border-top-color: var(--accent);
    animation: lgb-spin 0.8s linear infinite;
    pointer-events: none;
  }
  .lgb-spin[hidden] {
    display: none;
  }
  @keyframes lgb-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lgb-spin {
      animation-duration: 1.6s;
    }
  }
  .lgb-scroll img {
    width: auto;
    height: fit-content;
    border-radius: 14px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--border);
  }
  .lgb[data-device='mobile'] .lgb-scroll img {
    max-width: min(92vw, 420px);
  }
  .lgb[data-device='tablet'] .lgb-scroll img {
    max-width: min(94vw, 720px);
  }
  .lgb[data-device='desktop'] .lgb-scroll img {
    max-width: min(94vw, 1040px);
  }

  .lgb-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 74px;
    border-bottom: 1px solid var(--border);
    background: rgba(11, 11, 18, 0.7);
  }
  .lgb-title {
    position: absolute;
    left: 74px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .lgb-toggle {
    display: flex;
    gap: 6px;
    padding: 5px;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .dev {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 999px;
    border: none;
    background: none;
    color: var(--fg-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }
  .dev svg {
    width: 17px;
    height: 17px;
  }
  .dev.active {
    background: var(--brand-gradient, var(--accent));
    color: #fff;
  }
  .dev:disabled {
    opacity: 0.32;
    cursor: not-allowed;
  }
  /* display:inline-flex would override the [hidden] attribute — enforce it */
  .dev[hidden] {
    display: none;
  }

  .lgb-close,
  .lgb-nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.75);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .lgb-close:hover,
  .lgb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .lgb-close {
    top: 15px;
    right: 18px;
  }
  .lgb-close svg,
  .lgb-nav svg {
    width: 21px;
    height: 21px;
  }
  .lgb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .lgb-prev {
    left: 18px;
  }
  .lgb-next {
    right: 18px;
  }
  /* Phones: controls live in a solid bottom dock (device toggle centered,
     arrows at its sides) so nothing collides with the close button and the
     arrows never float invisibly over artwork. All device versions render
     full-width with vertical scroll, aspect ratio always preserved. */
  @media (max-width: 640px) {
    .lgb-title {
      display: none;
    }
    .lgb-bar {
      top: auto;
      bottom: 0;
      height: calc(64px + env(safe-area-inset-bottom, 0px));
      padding: 0 68px env(safe-area-inset-bottom, 0px);
      border-bottom: 0;
      border-top: 1px solid var(--border);
      background: rgba(11, 11, 18, 0.94);
    }
    .lgb-toggle {
      padding: 4px;
    }
    .dev {
      padding: 7px 11px;
      font-size: 0.8rem;
      gap: 5px;
    }
    .dev svg {
      width: 14px;
      height: 14px;
    }
    .lgb-scroll {
      inset: 0 0 calc(64px + env(safe-area-inset-bottom, 0px));
      padding: 14px 12px 22px;
    }
    .lgb-nav {
      top: auto;
      bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      transform: none;
    }
    .lgb-prev {
      left: 12px;
    }
    .lgb-next {
      right: 12px;
    }
  }

  /* casino "win flash": a gold light sweep crosses the tile on hover */
  @media (prefers-reduced-motion: no-preference) {
    .phone::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(115deg, transparent 35%, rgba(255, 214, 130, 0.26) 50%, transparent 65%);
      transform: translateX(-130%);
      pointer-events: none;
    }
    .lg-item:hover .phone::after {
      animation: winflash 0.65s ease forwards;
    }
  }
  @keyframes winflash {
    to {
      transform: translateX(130%);
    }
  }

</style>
