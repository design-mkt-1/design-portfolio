---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../lib/site';
import { cleanTitle } from '../lib/titles';
import { thumbFor } from '../lib/thumbs';
import { SIZE_LABEL, SIZE_RATIO, availableVideoSizes, type VideoItem } from '../data/projects';

interface Props {
  items: VideoItem[];
}
const { items } = Astro.props;

// Resolve server-side so the client script is base-safe. Repo paths go through
// url() (base-aware); absolute URLs pass through. A content-length cache-buster
// (?v=<bytes>) is appended to repo assets so a re-uploaded file (same filename)
// isn't served stale from the browser/CDN cache — the byte count changes with
// the content, and stays stable across unrelated deploys.
function bust(path: string): string {
  if (/^https?:\/\//.test(path)) return path;
  let v = '';
  try {
    v = String(statSync(join(process.cwd(), 'public', path)).size);
  } catch {
    /* file missing — leave unversioned */
  }
  return url(path) + (v ? `?v=${v}` : '');
}
const payload = items.map((v) => ({
  title: cleanTitle(v.title),
  poster: bust(v.poster),
  sizes: availableVideoSizes(v).map((k) => ({
    key: k,
    label: v.labels?.[k] ?? SIZE_LABEL[k],
    ratio: SIZE_RATIO[k],
    src: bust(v.src[k]!),
  })),
}));
---

<div class="vgrid">
  {
    items.map((v, i) => {
      const count = availableVideoSizes(v).length;
      return (
        <button class="vtile reveal" data-index={i} aria-haspopup="dialog">
          <span class="poster">
            <img src={url(thumbFor(v.poster)!)} alt={cleanTitle(v.title)} loading="lazy" decoding="async" />
            <span class="play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </span>
          <span class="vmeta">
            <span class="vtitle">{cleanTitle(v.title)}</span>
            <span class="vcount"><span>{count}</span> {count === 1 ? 'format' : 'formats'}</span>
          </span>
        </button>
      );
    })
  }
</div>

<script type="application/json" id="video-data" set:html={JSON.stringify(payload)} />

<div class="vlb" id="video-lightbox" role="dialog" aria-modal="true" aria-label="Video player" hidden>
  <button class="vlb-close" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="vlb-nav vlb-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button class="vlb-nav vlb-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
  </button>
  <div class="vlb-inner" role="document">
    <div class="vlb-stage" id="vlb-stage"></div>
    <div class="vlb-bar">
      <div class="vlb-title" id="vlb-title"></div>
      <div class="vlb-sizes" id="vlb-sizes" role="tablist" aria-label="Formats"></div>
    </div>
  </div>
</div>

<script>
  import { createLightbox } from '../lib/lightbox';

  const data = JSON.parse(document.getElementById('video-data')?.textContent || '[]');
  const lb = document.getElementById('video-lightbox')!;
  const stage = document.getElementById('vlb-stage')!;
  const titleEl = document.getElementById('vlb-title')!;
  const sizesEl = document.getElementById('vlb-sizes')!;
  let current = 0;
  let sizeIdx = 0;

  function renderPlayer() {
    const item = data[current];
    const s = item.sizes[sizeIdx];
    stage.style.aspectRatio = s.ratio;
    const v = document.createElement('video');
    v.src = s.src;
    v.poster = item.poster;
    v.controls = true;
    v.autoplay = true;
    v.playsInline = true;
    v.preload = 'metadata';
    stage.innerHTML = '';
    stage.appendChild(v);
  }
  function renderSizes() {
    const item = data[current];
    titleEl.textContent = item.title;
    sizesEl.innerHTML = '';
    item.sizes.forEach((s: any, i: number) => {
      const b = document.createElement('button');
      b.className = 'vlb-size' + (i === sizeIdx ? ' active' : '');
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', i === sizeIdx ? 'true' : 'false');
      b.innerHTML = `<strong>${s.key.replace('x', ':')}</strong><span>${s.label}</span>`;
      b.addEventListener('click', () => {
        sizeIdx = i;
        renderSizes();
        renderPlayer();
      });
      sizesEl.appendChild(b);
    });
  }
  const ctrl = createLightbox({
    root: lb,
    count: data.length,
    closeSelector: '.vlb-close',
    prevSelector: '.vlb-prev',
    nextSelector: '.vlb-next',
    swipe: { listen: stage },
    onShow(i) {
      current = i;
      sizeIdx = 0;
      renderSizes();
      renderPlayer();
    },
    onClose() {
      stage.innerHTML = ''; // unload the player so audio stops
    },
  });

  document.querySelectorAll<HTMLElement>('.vtile').forEach((t) => {
    t.addEventListener('click', () => ctrl.open(Number(t.dataset.index)));
  });
</script>

<style>
  .vgrid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .vtile {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    background: none;
    border: none;
    text-align: left;
    color: inherit;
  }
  .poster {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition: transform 0.3s var(--ease-expo), border-color 0.3s, box-shadow 0.3s;
  }
  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vtile:hover .poster {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
  }
  .play {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .play svg {
    width: 56px;
    height: 56px;
    padding: 15px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: background 0.2s, transform 0.3s var(--ease-expo);
  }
  .vtile:hover .play svg {
    background: color-mix(in srgb, var(--accent) 75%, black);
    transform: scale(1.06);
  }
  .vmeta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 0 4px;
  }
  .vtitle {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .vcount {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }

  /* Lightbox */
  .vlb[hidden] {
    display: none;
  }
  .vlb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgba(5, 5, 9, 0.9);
    backdrop-filter: blur(10px);
    animation: vfade 0.2s var(--ease-expo);
  }
  @keyframes vfade {
    from {
      opacity: 0;
    }
  }
  .vlb-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: min(94vw, 1100px);
  }
  .vlb-stage {
    width: 100%;
    max-width: min(94vw, 1100px);
    max-height: 74vh;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  /* portrait/square players stay centered and height-capped */
  .vlb-stage:not([style*='16 / 9']) {
    width: auto;
  }
  .vlb-stage :global(video) {
    width: 100%;
    height: 100%;
    display: block;
    background: #000;
    object-fit: contain;
  }
  .vlb-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .vlb-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .vlb-sizes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .vlb-sizes :global(.vlb-size) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 7px 13px;
    border-radius: 10px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    line-height: 1.2;
    cursor: pointer;
    transition: all 0.2s;
  }
  .vlb-sizes :global(.vlb-size strong) {
    font-size: 0.9rem;
    color: var(--fg);
  }
  .vlb-sizes :global(.vlb-size span) {
    font-size: 0.68rem;
  }
  .vlb-sizes :global(.vlb-size:hover) {
    border-color: var(--accent);
  }
  .vlb-sizes :global(.vlb-size.active) {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    border-color: var(--accent);
    color: var(--fg);
  }
  .vlb-close,
  .vlb-nav {
    position: fixed;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: rgba(20, 20, 31, 0.7);
    border: 1px solid var(--border);
    color: var(--fg);
    transition: background 0.2s, border-color 0.2s;
  }
  .vlb-close:hover,
  .vlb-nav:hover {
    border-color: var(--accent);
    background: var(--bg-elev-2);
  }
  .vlb-close {
    top: 20px;
    right: 20px;
  }
  .vlb-close svg,
  .vlb-nav svg {
    width: 22px;
    height: 22px;
  }
  .vlb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .vlb-prev {
    left: 18px;
  }
  .vlb-next {
    right: 18px;
  }
  /* Mobile: dvh-based sizing so the browser bar never clips the format tabs;
     bottom strip reserved for the nav arrows. */
  @media (max-width: 640px) {
    .vlb {
      padding: 12px;
    }
    .vlb-inner {
      gap: 12px;
      margin-bottom: 74px;
    }
    .vlb-stage {
      max-height: calc(100vh - 220px);
      max-height: calc(100dvh - 220px);
    }
    .vlb-title {
      font-size: 1rem;
    }
    .vlb-nav {
      top: auto;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      transform: none;
    }
    .vlb-prev {
      left: 30%;
    }
    .vlb-next {
      right: 30%;
    }
    .vlb-close {
      top: 14px;
      right: 14px;
    }
  }

  /* casino "win flash": a gold light sweep crosses the tile on hover */
  @media (prefers-reduced-motion: no-preference) {
    .poster::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(115deg, transparent 35%, rgba(255, 214, 130, 0.26) 50%, transparent 65%);
      transform: translateX(-130%);
      pointer-events: none;
    }
    .vtile:hover .poster::after {
      animation: winflash 0.65s ease forwards;
    }
  }
  @keyframes winflash {
    to {
      transform: translateX(130%);
    }
  }

</style>
