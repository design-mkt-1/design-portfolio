---
// Floating 3D creative wall behind the home hero — real Winboss/Win2 creative
// drifting slowly in perspective at low opacity. Image cards crossfade through
// the banner pool every few seconds; up to two cards play muted looping promo
// videos (lazy-started after page load so they never block first paint).
// Decorative only: aria-hidden, pointer-events none, two quiet cards on phones,
// static images (no videos, no cycling) under prefers-reduced-motion.
import { url } from '../lib/site';
import { thumbFor } from '../lib/thumbs';
import { projectBanners, projectVideos } from '../lib/portfolio';
import { firstSize } from '../data/projects';

const SLUGS = ['winboss', 'win2', 'jackpot', 'max-win'];

// image pool: interleaved brand-by-brand so consecutive picks (and therefore
// the visible wall) mix different projects. Only banners with a TRUE square
// version qualify — square masters always show the full design, whereas crops
// of wide banners can land on a text-only half (bad hero material).
const byBrand = SLUGS.map((slug) =>
  projectBanners(slug)
    .slice(0, 10)
    .map((item) => {
      const square = item.sizes['1x1'];
      const t = square ? thumbFor(square) : undefined;
      return t ? { s: url(t), p: slug } : null;
    })
    .filter((e): e is { s: string; p: string } => !!e),
);
const pool: { s: string; p: string }[] = [];
for (let i = 0; byBrand.some((b) => i < b.length); i++) {
  for (const b of byBrand) if (b[i]) pool.push(b[i]);
}

// video pool: every Winboss/Win2 video with a 1×1 version. Two cards play them
// (lazy-started after page load); when a clip ends the card moves on to a
// random one that isn't already playing elsewhere — no replays back-to-back.
const vids = SLUGS.flatMap((slug) => projectVideos(slug).filter((v) => v.src['1x1']));
const vPool = vids.map((v) => ({ poster: url(thumbFor(v.poster)!), src: url(v.src['1x1']!) }));
const nVideoCards = Math.min(2, vPool.length);
const vStart = Array.from({ length: nVideoCards }, (_, i) => Math.floor((i * vPool.length) / nVideoCards));
const videoPayload = vStart.map((idx) => ({ idx, poster: vPool[idx].poster }));

// 5 cards total: video cards take the two biggest slots, banners fill the rest.
// The interleaved pool means the first N distinct entries already come from N
// different brands, so no two cards open with the same artwork or project.
const seenSrc = new Set<string>();
const unique = pool.filter((e) => !seenSrc.has(e.s) && !!seenSrc.add(e.s));
const imgCount = 5 - videoPayload.length;
const imgCards = unique.slice(0, imgCount).map((e) => e.s);
---

{
  (pool.length > 0 || videoPayload.length > 0) && (
    <div class="hc" aria-hidden="true">
      {videoPayload.map((v) => (
        <div class="hc-card hc-video" data-vi={v.idx}>
          <img class="a" src={v.poster} alt="" decoding="async" />
          <video muted playsinline preload="none" />
        </div>
      ))}
      {imgCards.map((src) => (
        <div class="hc-card">
          <img class="a" src={src} alt="" decoding="async" />
          <img class="b" alt="" />
        </div>
      ))}
      <script type="application/json" id="hc-pool" set:html={JSON.stringify(pool)} />
      <script type="application/json" id="hc-vpool" set:html={JSON.stringify(vPool)} />
    </div>
  )
}

<script>
  const layer = document.querySelector<HTMLElement>('.hc');
  const poolEl = document.getElementById('hc-pool');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // mouse parallax: the wall drifts subtly against the cursor, bigger (closer)
  // cards moving more. Uses the CSS `translate` property so it composes with
  // the float animation's `transform`. Mouse-only; skipped for reduced motion.
  if (layer && !reduce && matchMedia('(hover: hover)').matches) {
    const cards = Array.from(layer.querySelectorAll<HTMLElement>('.hc-card'));
    const factors = cards.map((c) => (c.offsetWidth || 120) / 9);
    let nx = 0, ny = 0, cx = 0, cy = 0, raf = 0;
    const tick = () => {
      cx += (nx - cx) * 0.08;
      cy += (ny - cy) * 0.08;
      cards.forEach((c, i) => {
        c.style.translate = `${(-cx * factors[i]).toFixed(1)}px ${(-cy * factors[i] * 0.7).toFixed(1)}px`;
      });
      raf = Math.abs(nx - cx) > 0.001 || Math.abs(ny - cy) > 0.001 ? requestAnimationFrame(tick) : 0;
    };
    const wrap = layer.parentElement ?? layer;
    wrap.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = wrap.getBoundingClientRect();
      nx = (e.clientX - r.left) / r.width - 0.5;
      ny = (e.clientY - r.top) / r.height - 0.5;
      if (!raf) raf = requestAnimationFrame(tick);
    });
    wrap.addEventListener('pointerleave', () => {
      nx = 0;
      ny = 0;
      if (!raf) raf = requestAnimationFrame(tick);
    });
  }

  // lazy-start the video cards after page load; when a clip ends, advance to a
  // random pool entry not already playing on the other card (replay only when
  // the pool is too small to rotate)
  const vpoolEl = document.getElementById('hc-vpool');
  if (layer && vpoolEl && !reduce) {
    const vpool: { poster: string; src: string }[] = JSON.parse(vpoolEl.textContent || '[]');
    const vcards = Array.from(layer.querySelectorAll<HTMLElement>('.hc-video'));
    const vshow = vcards.map((c) => Number(c.dataset.vi) || 0);
    const startVideos = () => {
      vcards.forEach((card, ci) => {
        const v = card.querySelector('video')!;
        const img = card.querySelector<HTMLImageElement>('img.a')!;
        const playIdx = (idx: number) => {
          vshow[ci] = idx;
          img.src = vpool[idx].poster;
          v.src = vpool[idx].src;
          v.play().catch(() => {});
        };
        v.addEventListener('ended', () => {
          if (vpool.length <= vcards.length) {
            v.currentTime = 0;
            v.play().catch(() => {});
            return;
          }
          let idx = Math.floor(Math.random() * vpool.length);
          while (vshow.includes(idx)) idx = (idx + 1) % vpool.length;
          playIdx(idx);
        });
        playIdx(vshow[ci]);
      });
    };
    if (document.readyState === 'complete') startVideos();
    else window.addEventListener('load', startVideos, { once: true });
  }

  // crossfade a random image card to the next artwork every few seconds —
  // never to something already visible on another card, and preferring a brand
  // that isn't on the wall yet so the mix always spans different projects
  if (layer && poolEl && !reduce) {
    const raw: { s: string; p: string }[] = JSON.parse(poolEl.textContent || '[]');
    const dedup = new Set<string>();
    const pool = raw.filter((e) => !dedup.has(e.s) && !!dedup.add(e.s));
    const brandOf = new Map(pool.map((e) => [e.s, e.p]));
    const cards = Array.from(layer.querySelectorAll<HTMLElement>('.hc-card:not(.hc-video)'));
    const showing = cards.map((c) => c.querySelector<HTMLImageElement>('img.a')!.getAttribute('src') || '');
    let cursor = 0;
    const pickNext = (): string => {
      const visibleBrands = new Set(showing.map((s) => brandOf.get(s)));
      // pass 1: fresh artwork from a brand not currently visible; pass 2: any fresh artwork
      for (const needNewBrand of [true, false]) {
        for (let k = 0; k < pool.length; k++) {
          const cand = pool[cursor++ % pool.length];
          if (showing.includes(cand.s)) continue;
          if (needNewBrand && visibleBrands.has(cand.p)) continue;
          return cand.s;
        }
      }
      return '';
    };
    if (cards.length && pool.length > cards.length) {
      let last = -1;
      setInterval(() => {
        let i = Math.floor(Math.random() * cards.length);
        if (i === last) i = (i + 1) % cards.length;
        last = i;
        const card = cards[i];
        const a = card.querySelector<HTMLImageElement>('img.a')!;
        const b = card.querySelector<HTMLImageElement>('img.b')!;
        const next = pickNext();
        if (!next) return;
        showing[i] = next; // reserve immediately so parallel swaps can't collide
        b.onload = () => {
          card.classList.add('swap');
          setTimeout(() => {
            a.src = next;
            card.classList.remove('swap');
          }, 700);
        };
        b.src = next;
      }, 7000);
    }

    // Easter egg: clicking the hero logo re-spins the whole wall — image cards
    // blur-spin vertically like reels and land on fresh artwork, video cards
    // jump to their next clip, and EVERY card drifts to a fresh random spot
    // and scale so all five visibly change even mid-load.
    const allCards = Array.from(layer.querySelectorAll<HTMLElement>('.hc-card'));
    const baseWidths = allCards.map((c) => c.getBoundingClientRect().width);
    const shuffleWall = () => {
      const r = (a: number, b: number) => a + Math.random() * (b - a);
      allCards.forEach((c, i) => {
        c.style.width = `${Math.round(baseWidths[i] * r(0.82, 1.2))}px`;
        // symmetric margins nudge the box the same visual direction whichever
        // edge the slot is anchored to (left/right, top/bottom)
        const jx = Math.round(r(-38, 38));
        const jy = Math.round(r(-30, 30));
        c.style.margin = `${jy}px ${-jx}px ${-jy}px ${jx}px`;
      });
    };
    const logo = document.querySelector<HTMLElement>('.hero-logo img');
    if (logo && cards.length) {
      logo.style.cursor = 'pointer';
      logo.title = 'Spin the showcase';
      logo.tabIndex = 0;
      let busy = false;
      const respin = () => {
        if (busy) return;
        busy = true;
        shuffleWall();
        cards.forEach((card, i) => {
          const a = card.querySelector<HTMLImageElement>('img.a')!;
          const next = pickNext();
          if (!next) return;
          showing[i] = next;
          const out = a.animate(
            [
              { transform: 'translateY(0)', filter: 'blur(0)' },
              { transform: 'translateY(-115%)', filter: 'blur(3px)' },
            ],
            { duration: 220, delay: i * 70, easing: 'ease-in', fill: 'forwards' },
          );
          out.onfinish = () => {
            a.src = next;
            const back = a.animate(
              [
                { transform: 'translateY(115%)', filter: 'blur(3px)' },
                { transform: 'translateY(0)', filter: 'blur(0)' },
              ],
              { duration: 300, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' },
            );
            back.onfinish = () => out.cancel();
          };
        });
        layer.querySelectorAll<HTMLVideoElement>('.hc-video video').forEach((v, vi) =>
          setTimeout(() => v.dispatchEvent(new Event('ended')), vi * 110),
        );
        setTimeout(() => (busy = false), 1200);
      };
      logo.addEventListener('click', respin);
      logo.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          respin();
        }
      });
      // invite the tap: hint pill fades in shortly after load, disappears
      // forever (this visit) once the visitor has spun
      const hint = document.querySelector<HTMLElement>('.spin-hint');
      if (hint) {
        setTimeout(() => {
          hint.hidden = false;
        }, 1800);
        hint.addEventListener('click', respin);
        const dismiss = () => {
          hint.hidden = true;
        };
        logo.addEventListener('click', dismiss, { once: true });
        hint.addEventListener('click', dismiss, { once: true });
      }
    }
  }
</script>

<style>
  .hc {
    position: absolute;
    inset: 0;
    perspective: 1200px;
    pointer-events: none;
    z-index: 0;
  }
  .hc-card {
    position: absolute;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    opacity: 0.15;
    transform-style: preserve-3d;
    animation: hc-float var(--dur, 26s) ease-in-out var(--delay, 0s) infinite alternate;
    will-change: transform;
    /* spin reshuffle: cards glide to their new random spot/size (width and
       margins are only ever changed by the logo-spin easter egg) */
    transition: width 0.8s var(--ease-expo), margin 0.8s var(--ease-expo);
  }
  .hc-card img,
  .hc-card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hc-card img.b {
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .hc-card.swap img.b {
    opacity: 1;
  }
  /* the looping video sits above its poster; visible only once it has frames */
  .hc-video video {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .hc-video video[src] {
    opacity: 1;
  }

  /* base pose per card: --rx/--ry/--rz define its resting 3D tilt */
  @keyframes hc-float {
    from {
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) rotateZ(var(--rz, 0deg)) translateY(0);
    }
    to {
      transform: rotateX(calc(var(--rx, 0deg) * -0.6)) rotateY(calc(var(--ry, 0deg) * 1.4)) rotateZ(calc(var(--rz, 0deg) * -1)) translateY(-22px);
    }
  }

  /* video cards render first in the DOM, so they get the two biggest slots */
  .hc-card:nth-child(1) { right: 3%; top: 9%;     width: 200px; aspect-ratio: 1; --ry: -20deg; --rx: 8deg;  --rz: 3deg;  --dur: 31s; --delay: -9s; }
  .hc-card:nth-child(2) { left: 2%;  top: 14%;    width: 170px; aspect-ratio: 1; --ry: 22deg;  --rx: 6deg;  --rz: -4deg; --dur: 27s; }
  .hc-card:nth-child(3) { left: 9%;  bottom: 4%;  width: 140px; aspect-ratio: 1; --ry: 16deg;  --rx: -7deg; --rz: 5deg;  --dur: 24s; --delay: -14s; }
  .hc-card:nth-child(4) { right: 10%; bottom: 10%; width: 150px; aspect-ratio: 1; --ry: -14deg; --rx: -5deg; --rz: -6deg; --dur: 29s; --delay: -5s; }
  .hc-card:nth-child(5) { left: 22%; top: 2%;     width: 120px; aspect-ratio: 1; --ry: 12deg;  --rx: 10deg; --rz: 2deg;  --dur: 34s; --delay: -20s; }

  /* phones: four smaller edge cards, extra quiet, so the copy stays king */
  @media (max-width: 700px) {
    .hc-card { opacity: 0.1; }
    .hc-card:nth-child(1) { width: 108px; right: -5%; top: auto; bottom: 7%; }
    .hc-card:nth-child(2) { width: 98px;  left: -5%;  top: 4%; }
    .hc-card:nth-child(3) { width: 84px;  right: 3%;  top: 10%; bottom: auto; left: auto; }
    .hc-card:nth-child(4) { width: 90px;  left: 1%;   bottom: 22%; top: auto; right: auto; }
    .hc-card:nth-child(5) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-card {
      animation: none;
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) rotateZ(var(--rz, 0deg));
    }
  }
</style>
