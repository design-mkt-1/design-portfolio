---
import '../styles/fonts.css';
import '../styles/global.css';
import archivoLatin from '../styles/fonts/archivo-latin.woff2?url';
import groteskLatin from '../styles/fonts/space-grotesk-latin.woff2?url';
import { url } from '../lib/site';
import { assetExists } from '../lib/portfolio';
import { squareFavicon } from '../lib/thumbs';
import { pathAnalyticsId } from '../lib/analytics.mjs';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AnalyticsBody from '../components/AnalyticsBody.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
  accent?: string;
  /** per-project brand icon → browser-tab favicon (falls back to the MS mark) */
  favicon?: string;
  /** social-preview image (path under /public); defaults to the 1200×630 share card */
  ogImage?: string;
  /** single-screen pages (e.g. contact): drop the footer so nothing scrolls */
  noFooter?: boolean;
  /** keep the page out of search results (e.g. 404) */
  noindex?: boolean;
}
const {
  title,
  description = 'Design portfolio by Marketing Solutions.',
  crumbs = [],
  accent,
  favicon,
  ogImage = 'assets/og-card.png',
  noFooter = false,
  noindex = false,
} = Astro.props;

// Canonical URLs always point at the production domain. The GitHub Pages build
// (base /design-portfolio) is a preview: same pages, noindex, canonical to prod.
const ORIGIN = process.env.CANONICAL_ORIGIN || 'https://design.marketing-solutions.ro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const isPreview = BASE !== '';
const pathNoBase = Astro.url.pathname.slice(BASE.length) || '/';
const canonical = new URL(pathNoBase, ORIGIN).href;
const robots = noindex || isPreview ? 'noindex' : undefined;

// Structured data: who runs the site, the site itself, and where this page sits.
const abs = (href: string) => new URL(href.endsWith('/') ? href : `${href}/`, ORIGIN).href;
const breadcrumb = crumbs.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: c.href ? abs(c.href) : canonical,
      })),
    }
  : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${ORIGIN}/#org`,
      name: 'Marketing Solutions',
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/assets/marketing-solutions-logo.webp`,
      sameAs: ['https://www.linkedin.com/company/marketing-solutions-romania/'],
    },
    { '@type': 'WebSite', '@id': `${ORIGIN}/#site`, name: 'Marketing Solutions — Design Portfolio', url: `${ORIGIN}/`, publisher: { '@id': `${ORIGIN}/#org` } },
    { '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, isPartOf: { '@id': `${ORIGIN}/#site` } },
    ...(breadcrumb ? [breadcrumb] : []),
  ],
};
const ogImageAbs = Astro.site ? new URL(url(ogImage), Astro.site).href : url(ogImage);

// Per-project favicon when the file is actually on disk; MS mark otherwise.
// squareFavicon() serves the letterboxed square PNG so non-square brand marks
// aren't stretched by the browser's square tab slot.
const faviconHref = url(squareFavicon(favicon && assetExists(favicon) ? favicon : 'assets/favicon_ms.webp'));
const pagePath = Astro.url.pathname.toLowerCase();
const siteSection = pagePath.includes('/contact')
  ? 'contact'
  : pagePath.includes('/work/')
    ? 'work'
    : pagePath.includes('/portfolio/')
      ? 'portfolio'
      : pagePath.includes('/brandbook')
        ? 'brandbook'
        : pagePath.endsWith('/404') || pagePath.endsWith('/404.html')
          ? 'error'
          : pagePath === '/' || /\/design-portfolio\/?$/.test(pagePath)
          ? 'home'
            : 'project';

// The design portfolio stays on its specialist Astro subdomain, while these
// canonical links make its global navigation behave as one agency ecosystem.
const MAIN_SITE = 'https://marketing-solutions.ro';
// Keep the shared brand assets in this build: navigation must not depend on
// cross-site image delivery when a client enters from a QR, ad, or deep link.
const MAIN_LOGO = url('assets/marketing-solutions-agency-logo.png');
const ONJN_LOGO = url('assets/onjn-romania.png');
const services = [
  ['PPC & Paid Advertising', `${MAIN_SITE}/ppc-paid-advertising/`],
  ['Influencer Marketing', `${MAIN_SITE}/influencer-marketing/`],
  ['SEO & Organic Growth', `${MAIN_SITE}/seo-and-organic-growth/`],
  ['Social Media Marketing', `${MAIN_SITE}/social-media-marketing/`],
  ['Copywriting', `${MAIN_SITE}/copywriting/`],
  ['Creative Strategy & UX/UI Design', `${MAIN_SITE}/creative-strategy-and-ux-ui-design/`],
  ['App Store Optimization', `${MAIN_SITE}/app-store-optimization/`],
  ['Web Design', `${MAIN_SITE}/web-design/`],
  ['Strategy & Consulting', `${MAIN_SITE}/strategy-and-consulting/`],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* mark JS as available before any CSS applies — reveal animations only
        hide content under html.js, so no-JS/slow-JS visitors see everything */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <AnalyticsHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={faviconHref} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('assets/_thumbs/favicons/apple-touch-icon.png')} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Locale variants: /ro/… and /ru/… are generated at build time by
        src/integrations/localize.mjs (same pages, translated HTML). Every
        variant lists all three; EN is the default. */}
    {
      !robots && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(pathNoBase, ORIGIN).href} />
          <link rel="alternate" hreflang="ro" href={new URL(`/ro${pathNoBase}`, ORIGIN).href} />
          <link rel="alternate" hreflang="ru" href={new URL(`/ru${pathNoBase}`, ORIGIN).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(pathNoBase, ORIGIN).href} />
        </>
      )
    }

    {/* Open Graph / Twitter — rich previews when links are shared */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marketing Solutions" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ro_RO" />
    <meta property="og:locale:alternate" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    {
      accent && (
        /* :root:root beats global.css's single :root so the override wins regardless of load order */
        <style
          set:html={`:root:root{--accent:${accent};--accent-glow:color-mix(in srgb, ${accent} 32%, transparent);}`}
        />
      )
    }
  </head>
  <body data-site-section={siteSection}>
    <a class="skip" href="#main">Skip to content</a>
    <AnalyticsBody />
    <header class="site-header">
      <div class="container header-inner">
        <a
          class="brand"
          href={`${MAIN_SITE}/`}
          aria-label="Marketing Solutions home"
          data-analytics-event="navigation_click"
          data-analytics-id="header_home"
          data-analytics-location="header"
        >
          <img class="brand-mark" src={MAIN_LOGO} alt="Marketing Solutions" width="190" height="60" />
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          <a href={`${MAIN_SITE}/`} data-analytics-event="navigation_click" data-analytics-id="header_main_home" data-analytics-location="header">Home</a>
          <details class="services-dropdown">
            <summary>Services <span aria-hidden="true">⌄</span></summary>
            <div class="services-menu">
              {services.map(([label, href]) => (
                <a href={href} data-analytics-event="navigation_click" data-analytics-id={`header_service_${label.toLowerCase().replace(/[^a-z0-9]+/g, '_')}`} data-analytics-location="header">{label}</a>
              ))}
            </div>
          </details>
          <a href={`${MAIN_SITE}/about-us/`} data-analytics-event="navigation_click" data-analytics-id="header_about" data-analytics-location="header">About Us</a>
          <a href={`${MAIN_SITE}/portfolio/`} data-analytics-event="navigation_click" data-analytics-id="header_portfolio" data-analytics-location="header">Portfolio</a>
          <a class="nav-active" href={url('/')} aria-current="page" data-analytics-event="navigation_click" data-analytics-id="header_design" data-analytics-location="header">Design</a>
          <a href={`${MAIN_SITE}/contact-us/`} data-i18n="nav.contact" data-analytics-event="cta_click" data-analytics-id="header_contact" data-analytics-type="link" data-analytics-location="header">Contact Us</a>
        </nav>

        <div class="lang-switch" role="group" aria-label="Language">
          <button type="button" class="lang-btn" data-lang="en" data-selected-language="en" data-analytics-event="language_change" data-analytics-id="language_en" data-analytics-location="header">EN</button>
          <button type="button" class="lang-btn" data-lang="ro" data-selected-language="ro" data-analytics-event="language_change" data-analytics-id="language_ro" data-analytics-location="header">RO</button>
          <button type="button" class="lang-btn" data-lang="ru" data-selected-language="ru" data-analytics-event="language_change" data-analytics-id="language_ru" data-analytics-location="header">RU</button>
        </div>
        <button class="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-controls="mobile-navigation" aria-expanded="false" data-menu-toggle>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <nav id="mobile-navigation" class="mobile-navigation" aria-label="Mobile navigation" hidden data-mobile-navigation>
      <div class="container mobile-navigation-inner">
        <a href={`${MAIN_SITE}/`} data-analytics-event="navigation_click" data-analytics-id="mobile_home" data-analytics-location="mobile_navigation">Home</a>
        <details class="mobile-services">
          <summary>Services <span aria-hidden="true">⌄</span></summary>
          <div>
            {services.map(([label, href]) => (
              <a href={href} data-analytics-event="navigation_click" data-analytics-id={`mobile_service_${label.toLowerCase().replace(/[^a-z0-9]+/g, '_')}`} data-analytics-location="mobile_navigation">{label}</a>
            ))}
          </div>
        </details>
        <a href={`${MAIN_SITE}/about-us/`} data-analytics-event="navigation_click" data-analytics-id="mobile_about" data-analytics-location="mobile_navigation">About Us</a>
        <a href={`${MAIN_SITE}/portfolio/`} data-analytics-event="navigation_click" data-analytics-id="mobile_portfolio" data-analytics-location="mobile_navigation">Portfolio</a>
        <a class="nav-active" href={url('/')} aria-current="page" data-analytics-event="navigation_click" data-analytics-id="mobile_design" data-analytics-location="mobile_navigation">Design</a>
        <a class="mobile-contact" href={`${MAIN_SITE}/contact-us/`} data-analytics-event="cta_click" data-analytics-id="mobile_contact" data-analytics-type="link" data-analytics-location="mobile_navigation">Contact Us</a>
      </div>
    </nav>

    {
      crumbs.length > 0 && (
        <nav class="container crumbs" aria-label="Breadcrumb">
          {crumbs.map((c, i) => (
            <>
              {
                c.href ? (
                  <a
                    href={url(c.href)}
                    data-analytics-event="navigation_click"
                    data-analytics-id={pathAnalyticsId('breadcrumb', c.href)}
                    data-analytics-location="breadcrumb"
                  >
                    {c.label}
                  </a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )
              }
              {i < crumbs.length - 1 && <span class="sep">/</span>}
            </>
          ))}
        </nav>
      )
    }

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer" hidden={noFooter}>
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href={`${MAIN_SITE}/`} aria-label="Marketing Solutions home">
            <img src={MAIN_LOGO} alt="Marketing Solutions" width="220" height="70" />
          </a>
          <p>A full-service digital marketing agency obsessed with driving measurable revenue growth for ambitious brands.</p>
        </div>
        <div class="footer-column">
          <h2>Services</h2>
          <nav aria-label="Services">
            {services.map(([label, href]) => (
              <a href={href} data-analytics-event="navigation_click" data-analytics-id={`footer_service_${label.toLowerCase().replace(/[^a-z0-9]+/g, '_')}`} data-analytics-location="footer">{label}</a>
            ))}
          </nav>
        </div>
        <div class="footer-column">
          <h2>Company</h2>
          <nav aria-label="Company">
            <a href={`${MAIN_SITE}/`} data-analytics-event="navigation_click" data-analytics-id="footer_home" data-analytics-location="footer">Home</a>
            <a href={`${MAIN_SITE}/about-us/`} data-analytics-event="navigation_click" data-analytics-id="footer_about" data-analytics-location="footer">About Us</a>
            <a href={`${MAIN_SITE}/portfolio/`} data-analytics-event="navigation_click" data-analytics-id="footer_portfolio" data-analytics-location="footer">Portfolio</a>
            <a class="footer-design" href={url('/')} data-analytics-event="navigation_click" data-analytics-id="footer_design" data-analytics-location="footer">Design</a>
            <a href={`${MAIN_SITE}/contact-us/`} data-analytics-event="navigation_click" data-analytics-id="footer_contact" data-analytics-location="footer">Contact Us</a>
          </nav>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© 2026 Marketing-Solutions. All rights reserved.</p>
        <div class="onjn-license" aria-label="ONJN Romania licence information">
          <span>Decizie ONJN nr 1791/30.08.2023</span>
          <span class="age-badge">18<sup>+</sup></span>
          <img src={ONJN_LOGO} alt="ONJN Romania" width="36" height="36" />
        </div>
      </div>
    </footer>
    {/* outside the footer so pages without one (contact) can still reopen consent */}
    <div class="container page-end">
      <button class="consent-settings" id="consent-settings" type="button" aria-haspopup="dialog">Privacy settings</button>
    </div>

    <script>
      // Staggered scroll-reveal (expo). Elements with .reveal fade/slide in.
      const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        els.forEach((el, i) => {
          el.style.setProperty('--reveal-delay', `${Math.min(i * 60, 400)}ms`);
          io.observe(el);
        });
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      // Mobile navigation: an explicit button keeps all agency links reachable
      // from every portfolio route without hiding the brand header on load.
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mobileNav = document.querySelector<HTMLElement>('[data-mobile-navigation]');
      const setMobileMenu = (open: boolean) => {
        if (!menuToggle || !mobileNav) return;
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        menuToggle.classList.toggle('is-open', open);
        mobileNav.hidden = !open;
        document.body.classList.toggle('menu-open', open);
      };
      menuToggle?.addEventListener('click', () => setMobileMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobileMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMobileMenu(false);
      });
    </script>

    <script>
      // In-page i18n: swap English UI text for RO/RU, client-side.
      import { STRINGS, LOCALES } from '../i18n/ui';
      const IDX = { en: 0, ro: 1, ru: 2 } as Record<string, number>;
      // Markup text wraps across source lines, so match on collapsed whitespace.
      const norm = (s: string) => s.replace(/\s+/g, ' ').trim();
      const byEn: Record<string, string[]> = {};
      const byKey: Record<string, string[]> = {};
      for (const [key, row] of Object.entries(STRINGS)) {
        // First row wins when two keys share an English value (e.g. stat.brands /
        // work.brands); the later ones are reached through data-i18n.
        byEn[norm(row[0])] ??= row;
        byKey[key] = row;
      }
      const trEn = (en: string, lang: string) => (byEn[en] ? byEn[en][IDX[lang]] : en);
      const trKey = (key: string, lang: string) => (byKey[key] ? byKey[key][IDX[lang]] : key);

      // Collect translatable text nodes (whose normalized text is a known English string).
      const nodes: { node: Text; en: string; pre: string; post: string }[] = [];
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode(n) {
          const txt = norm(n.nodeValue || '');
          return txt && byEn[txt] ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        },
      });
      let cur: Node | null;
      while ((cur = walker.nextNode())) {
        const v = cur.nodeValue || '';
        nodes.push({ node: cur as Text, en: norm(v), pre: v.match(/^\s*/)![0], post: v.match(/\s*$/)![0] });
      }
      // Screen-reader labels translate the same way as visible text.
      const labels = Array.from(document.querySelectorAll<HTMLElement>('[aria-label]'))
        .map((el) => ({ el, en: norm(el.getAttribute('aria-label') || '') }))
        .filter((it) => byEn[it.en]);

      // Translate the <title> too (SEO: RO/RU variants index with localized
      // titles). Known English phrases are replaced longest-first; brand and
      // project names pass through untouched.
      const titleEn = document.title;
      const phrases = Object.keys(byEn).sort((a, b) => b.length - a.length);
      function translateTitle(lang: string) {
        if (lang === 'en') return titleEn;
        let t = titleEn;
        for (const p of phrases) if (t.includes(p)) t = t.split(p).join(trEn(p, lang));
        return t;
      }

      function apply(lang: string) {
        for (const it of nodes) it.node.nodeValue = it.pre + trEn(it.en, lang) + it.post;
        for (const it of labels) it.el.setAttribute('aria-label', trEn(it.en, lang));
        document.title = translateTitle(lang);
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          el.textContent = trKey(el.dataset.i18n || '', lang);
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-ph]').forEach((el) => {
          el.setAttribute('placeholder', trKey(el.getAttribute('data-i18n-ph') || '', lang));
        });
        document.documentElement.lang = lang;
        window.__lang = lang;
        window.__tk = trKey;
        document.querySelectorAll<HTMLElement>('.lang-btn').forEach((b) => {
          const on = b.dataset.lang === lang;
          if (on && !b.classList.contains('active') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            b.classList.add('rolling');
            b.addEventListener('animationend', () => b.classList.remove('rolling'), { once: true });
          }
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', String(on));
        });
      }
      // RO/RU are real pages under /ro/ and /ru/ (built by src/integrations/
      // localize.mjs), so switching language navigates. `astro dev` has no
      // such pages and keeps translating in place.
      const isLocale = (l: string | null): l is string => !!l && (LOCALES as readonly string[]).includes(l);
      const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
      const pageLang = isLocale(document.documentElement.lang) ? document.documentElement.lang : 'en';
      const pathFor = (lang: string) => {
        const p = (location.pathname.slice(BASE_PATH.length) || '/').replace(/^\/(ro|ru)(?=\/)/, '');
        return `${BASE_PATH}${lang === 'en' ? '' : `/${lang}`}${p}${location.hash}`;
      };
      function setLang(lang: string) {
        if (!isLocale(lang)) lang = 'en';
        if (import.meta.env.DEV) apply(lang);
        else if (lang !== pageLang) location.assign(pathFor(lang));
      }
      // old shared links used ?lang=ro / ?lang=ru
      const legacy = new URLSearchParams(location.search).get('lang');
      if (!import.meta.env.DEV && isLocale(legacy) && legacy !== pageLang) location.replace(pathFor(legacy));
      apply(import.meta.env.DEV && isLocale(legacy) ? legacy : pageLang);
      document
        .querySelectorAll<HTMLElement>('.lang-btn')
        .forEach((b) => b.addEventListener('click', () => setLang(b.dataset.lang || 'en')));
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 60;
        border-bottom: 1px solid var(--border);
        background: linear-gradient(to bottom, rgba(10, 10, 15, 0.94), rgba(10, 10, 15, 0.83));
        backdrop-filter: blur(20px);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: 22px;
        min-height: 84px;
      }
      .brand {
        position: relative;
        display: inline-flex;
        flex: none;
        align-items: center;
        transition: opacity 0.2s;
      }
      .brand:hover { opacity: 0.86; }
      .brand-mark { width: auto; height: 58px; object-fit: contain; }
      .primary-nav {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-left: auto;
      }
      .primary-nav > a,
      .services-dropdown > summary {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--fg-muted);
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        list-style: none;
        transition: color 0.2s ease;
      }
      .services-dropdown > summary::-webkit-details-marker { display: none; }
      .services-dropdown > summary span { margin-left: 5px; color: var(--fg-dim); font-size: 0.8rem; transition: transform 0.2s ease; }
      .services-dropdown[open] > summary span { transform: rotate(180deg); }
      .primary-nav > a::after,
      .services-dropdown > summary::after {
        position: absolute;
        right: 0;
        bottom: 4px;
        left: 0;
        height: 2px;
        content: '';
        background: var(--brand-gradient);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s var(--ease-expo);
      }
      .primary-nav > a:hover,
      .services-dropdown > summary:hover,
      .primary-nav > a.nav-active { color: var(--fg); }
      .primary-nav > a:hover::after,
      .services-dropdown > summary:hover::after,
      .primary-nav > a.nav-active::after { transform: scaleX(1); }
      .primary-nav > a.nav-active { color: var(--brand-teal); font-weight: 700; }
      .services-dropdown { position: relative; }
      .services-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 50%;
        display: grid;
        width: min(290px, 80vw);
        gap: 2px;
        padding: 9px;
        border: 1px solid var(--border-strong);
        border-radius: 16px;
        background: rgba(18, 18, 26, 0.98);
        box-shadow: var(--shadow);
        transform: translateX(-50%);
