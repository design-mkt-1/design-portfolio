      .services-menu a {
        padding: 10px 12px;
        border-radius: 9px;
        color: var(--fg-muted);
        font-size: 0.83rem;
        line-height: 1.35;
        transition: color 0.2s, background 0.2s;
      }
      .services-menu a:hover { color: var(--brand-teal); background: rgba(35, 198, 170, 0.08); }
      .lang-switch {
        display: inline-flex;
        flex: none;
        gap: 2px;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--bg-elev);
      }
      .lang-btn {
        position: relative;
        padding: 5px 9px;
        border: 0;
        border-radius: 999px;
        background: none;
        color: var(--fg-muted);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        transition: color 0.2s, background 0.2s;
      }
      .lang-btn:hover { color: var(--fg); }
      .lang-btn.active { color: var(--fg); background: color-mix(in srgb, var(--accent) 55%, transparent); }
      .lang-btn.rolling { animation: lang-roll 0.5s var(--ease-back); }
      @keyframes lang-roll { from { transform: rotate(0); } to { transform: rotate(360deg); } }
      .mobile-menu-toggle { display: none; }
      .skip {
        position: absolute;
        z-index: 100;
        top: 8px;
        left: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--bg-elev);
        color: var(--fg);
        transform: translateY(-200%);
      }
      .skip:focus { transform: none; }
      main:focus { outline: none; }
      main { min-height: calc(100vh - 84px - 80px); }
      .crumbs {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        color: var(--fg-muted);
        font-size: 0.85rem;
        overflow-x: auto;
        white-space: nowrap;
      }
      .crumbs a { color: var(--fg-muted); transition: color 0.2s; }
      .crumbs a:hover,
      .crumbs [aria-current='page'] { color: var(--fg); }
      .crumbs .sep { color: var(--fg-dim); }
      .site-footer {
        margin-top: 100px;
        border-top: 1px solid var(--border);
        background: var(--bg-elev);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(170px, 1fr) minmax(150px, 0.82fr);
        gap: clamp(32px, 6vw, 72px);
        padding: 68px 24px 56px;
        border-bottom: 1px solid var(--border);
      }
      .footer-brand img { width: auto; height: 72px; object-fit: contain; }
      .footer-brand p {
        max-width: 340px;
        margin: 18px 0 0;
        color: var(--fg-muted);
        font-size: 0.9rem;
        line-height: 1.7;
      }
      .footer-column h2 {
        margin: 10px 0 18px;
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .footer-column nav { display: grid; gap: 10px; }
      .footer-column a {
        width: fit-content;
        color: var(--fg-muted);
        font-size: 0.88rem;
        transition: color 0.2s;
      }
      .footer-column a:hover,
      .footer-column a.footer-design { color: var(--brand-teal); }
      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        min-height: 84px;
        color: var(--fg-dim);
        font-size: 0.82rem;
      }
      .footer-bottom p { margin: 0; }
      .onjn-license {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--fg);
        font-size: 0.78rem;
        font-weight: 500;
        white-space: nowrap;
      }
      .onjn-license img { width: 36px; height: 36px; border-radius: 50%; object-fit: contain; }
      .age-badge {
        position: relative;
        display: inline-grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border: 2px solid var(--fg);
        border-radius: 50%;
        color: var(--fg);
        font-size: 0.82rem;
        font-weight: 800;
      }
      .age-badge sup { position: absolute; top: 1px; right: 2px; font-size: 0.58rem; }
      .page-end { display: flex; justify-content: flex-end; }
      @media (max-width: 1100px) {
        .primary-nav { display: none; }
        .lang-switch { margin-left: auto; }
        .mobile-menu-toggle {
          display: grid;
          width: 44px;
          height: 44px;
          padding: 11px;
          border: 1px solid var(--border-strong);
          border-radius: 12px;
          background: var(--bg-elev);
          gap: 5px;
        }
        .mobile-menu-toggle span {
          display: block;
          width: 100%;
          height: 2px;
          border-radius: 2px;
          background: var(--fg);
          transition: transform 0.22s var(--ease-expo), opacity 0.18s;
        }
        .mobile-menu-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .mobile-menu-toggle.is-open span:nth-child(2) { opacity: 0; }
        .mobile-menu-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
        .mobile-navigation {
          position: fixed;
          z-index: 50;
          inset: 84px 0 0;
          overflow-y: auto;
          background: rgba(10, 10, 15, 0.985);
          backdrop-filter: blur(20px);
        }
        .mobile-navigation-inner { display: grid; gap: 0; padding-top: 18px; padding-bottom: 36px; }
        .mobile-navigation a,
        .mobile-services > summary {
          display: flex;
          align-items: center;
          justify-content: space-between;
          min-height: 58px;
          border-bottom: 1px solid var(--border);
          color: var(--fg);
          font-family: var(--font-display);
          font-size: 1.08rem;
          font-weight: 600;
          list-style: none;
        }
        .mobile-services > summary::-webkit-details-marker { display: none; }
        .mobile-services > summary span { transition: transform 0.2s; }
        .mobile-services[open] > summary span { transform: rotate(180deg); }
        .mobile-services > div { display: grid; padding: 4px 0 10px 18px; }
        .mobile-services > div a {
          min-height: 42px;
          border: 0;
          color: var(--fg-muted);
          font-family: var(--font-body);
          font-size: 0.9rem;
          font-weight: 500;
        }
        .mobile-navigation a.nav-active { color: var(--brand-teal); }
        .mobile-navigation .mobile-contact {
          justify-content: center;
          margin-top: 28px;
          border: 0;
          border-radius: 999px;
          color: var(--accent-fg);
          background: var(--brand-gradient);
          font-family: var(--font-body);
          font-size: 0.95rem;
          font-weight: 700;
        }
        :global(body.menu-open) { overflow: hidden; }
      }
      @media (min-width: 1101px) { .mobile-navigation { display: none !important; } }
      @media (max-width: 800px) {
        .footer-grid { grid-template-columns: 1fr 1fr; padding-top: 52px; }
        .footer-brand { grid-column: 1 / -1; }
      }
      @media (max-width: 560px) {
        .header-inner { min-height: 76px; gap: 12px; }
        .brand-mark { height: 46px; max-width: 142px; }
        .lang-btn { padding: 5px 7px; font-size: 0.7rem; }
        .mobile-navigation { top: 76px; }
        .crumbs { min-height: 38px; font-size: 0.78rem; }
        .footer-grid { grid-template-columns: 1fr; gap: 32px; padding: 46px 24px 42px; }
        .footer-brand { grid-column: auto; }
        .footer-brand img { height: 62px; }
        .footer-bottom { flex-direction: column; align-items: flex-start; justify-content: center; padding: 24px 0; }
        .onjn-license { align-items: flex-start; flex-wrap: wrap; white-space: normal; }
      }
    </style>
  </body>
</html>
