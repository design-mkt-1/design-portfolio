---
import '../styles/global.css';
import { url } from '../lib/site';
import { assetExists } from '../lib/portfolio';
import { squareFavicon } from '../lib/thumbs';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
  accent?: string;
  /** per-project brand icon → browser-tab favicon (falls back to the MS mark) */
  favicon?: string;
  /** social-preview image (path under /public); defaults to the 1200×630 share card */
  ogImage?: string;
  /** single-screen pages (e.g. contact): drop the footer so nothing scrolls */
  noFooter?: boolean;
}
const {
  title,
  description = 'Design portfolio by Marketing Solutions.',
  crumbs = [],
  accent,
  favicon,
  ogImage = 'assets/og-card.png',
  noFooter = false,
} = Astro.props;

// Absolute URLs for social/canonical tags (Astro.site is configured in astro.config.mjs).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageAbs = Astro.site ? new URL(url(ogImage), Astro.site).href : url(ogImage);

// Per-project favicon when the file is actually on disk; MS mark otherwise.
// squareFavicon() serves the letterboxed square PNG so non-square brand marks
// aren't stretched by the browser's square tab slot.
const faviconHref = url(squareFavicon(favicon && assetExists(favicon) ? favicon : 'assets/favicon_ms.webp'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={faviconHref} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('assets/_thumbs/favicons/apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Locale variants: RO/RU render via ?lang=… (client i18n; Googlebot executes
        JS, so translated content on these URLs is indexable). hreflang tells
        crawlers the three variants belong together; EN is the default. */}
    {canonical && <link rel="alternate" hreflang="en" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="ro" href={`${canonical}?lang=ro`} />}
    {canonical && <link rel="alternate" hreflang="ru" href={`${canonical}?lang=ru`} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}

    {/* Open Graph / Twitter — rich previews when links are shared */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marketing Solutions" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ro_RO" />
    <meta property="og:locale:alternate" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      accent && (
        /* :root:root beats global.css's single :root so the override wins regardless of load order */
        <style
          set:html={`:root:root{--accent:${accent};--accent-glow:color-mix(in srgb, ${accent} 32%, transparent);}`}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')} aria-label="Marketing Solutions — home">
          <img class="brand-full" src={url('assets/marketing-solutions-logo.webp')} alt="Marketing Solutions" height="34" />
          <img class="brand-mark" src={url(squareFavicon('assets/favicon_ms.webp'))} alt="Marketing Solutions" height="36" width="36" />
        </a>
        {
          crumbs.length > 0 && (
            <nav class="crumbs" aria-label="Breadcrumb">
              {crumbs.map((c, i) => (
                <>
                  {c.href ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                  {i < crumbs.length - 1 && <span class="sep">/</span>}
                </>
              ))}
            </nav>
          )
        }
        <div class="lang-switch" role="group" aria-label="Language">
          <button type="button" class="lang-btn" data-lang="en">EN</button>
          <button type="button" class="lang-btn" data-lang="ro">RO</button>
          <button type="button" class="lang-btn" data-lang="ru">RU</button>
        </div>
        {/* keyed (data-i18n) so it never collides with the contact page's identical English heading */}
        <a class="header-cta" href={url('/contact')} data-i18n="nav.contact">Contact us</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer" hidden={noFooter}>
      <div class="container footer-inner">
        <span class="muted">© Marketing Solutions — Design Portfolio</span>
        <a
          class="footer-li"
          href="https://www.linkedin.com/company/marketing-solutions-romania/"
          target="_blank"
          rel="noopener"
          aria-label="Marketing Solutions on LinkedIn"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          LinkedIn
        </a>
      </div>
      <div class="container">
        <p class="footer-age">18+ · Responsible, compliance-aware creative for licensed iGaming operators.</p>
      </div>
    </footer>

    <script>
      // Staggered scroll-reveal (expo). Elements with .reveal fade/slide in.
      const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        els.forEach((el, i) => {
          el.style.setProperty('--reveal-delay', `${Math.min(i * 60, 400)}ms`);
          io.observe(el);
        });
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      // Mobile: keep the header hidden at the very top (hero shows first), then
      // reveal it once the user scrolls down a bit.
      const header = document.querySelector('.site-header');
      if (header) {
        const onScroll = () => header.classList.toggle('revealed', window.scrollY > 60);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>

    <script>
      // In-page i18n: swap English UI text for RO/RU, client-side.
      import { STRINGS, LOCALES } from '../i18n/ui';
      const IDX = { en: 0, ro: 1, ru: 2 } as Record<string, number>;
      const byEn: Record<string, string[]> = {};
      const byKey: Record<string, string[]> = {};
      for (const [key, row] of Object.entries(STRINGS)) {
        byEn[row[0]] = row;
        byKey[key] = row;
      }
      const trEn = (en: string, lang: string) => (byEn[en] ? byEn[en][IDX[lang]] : en);
      const trKey = (key: string, lang: string) => (byKey[key] ? byKey[key][IDX[lang]] : key);

      // Collect translatable text nodes (whose trimmed text is a known English string).
      const nodes: { node: Text; en: string; pre: string; post: string }[] = [];
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode(n) {
          const txt = (n.nodeValue || '').trim();
          return txt && byEn[txt] ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        },
      });
      let cur: Node | null;
      while ((cur = walker.nextNode())) {
        const v = cur.nodeValue || '';
        const txt = v.trim();
        const i = v.indexOf(txt);
        nodes.push({ node: cur as Text, en: txt, pre: v.slice(0, i), post: v.slice(i + txt.length) });
      }

      // Translate the <title> too (SEO: RO/RU variants index with localized
      // titles). Known English phrases are replaced longest-first; brand and
      // project names pass through untouched.
      const titleEn = document.title;
      const phrases = Object.keys(byEn).sort((a, b) => b.length - a.length);
      function translateTitle(lang: string) {
        if (lang === 'en') return titleEn;
        let t = titleEn;
        for (const p of phrases) if (t.includes(p)) t = t.split(p).join(trEn(p, lang));
        return t;
      }

      function apply(lang: string) {
        for (const it of nodes) it.node.nodeValue = it.pre + trEn(it.en, lang) + it.post;
        document.title = translateTitle(lang);
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          el.textContent = trKey(el.dataset.i18n || '', lang);
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-ph]').forEach((el) => {
          el.setAttribute('placeholder', trKey(el.getAttribute('data-i18n-ph') || '', lang));
        });
        document.documentElement.lang = lang;
        (window as any).__lang = lang;
        (window as any).__tk = trKey;
        document.querySelectorAll<HTMLElement>('.lang-btn').forEach((b) => {
          const on = b.dataset.lang === lang;
          if (on && !b.classList.contains('active') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            b.classList.add('rolling');
            b.addEventListener('animationend', () => b.classList.remove('rolling'), { once: true });
          }
          b.classList.toggle('active', on);
        });
      }
      function setLang(lang: string) {
        if (!(LOCALES as readonly string[]).includes(lang)) lang = 'en';
        try {
          localStorage.setItem('ms-lang', lang);
        } catch {}
        const u = new URL(location.href);
        if (lang === 'en') u.searchParams.delete('lang');
        else u.searchParams.set('lang', lang);
        history.replaceState(null, '', u);
        apply(lang);
      }
      const stored = (() => {
        try {
          return localStorage.getItem('ms-lang');
        } catch {
          return null;
        }
      })();
      let initial = new URLSearchParams(location.search).get('lang') || stored || 'en';
      if (!(LOCALES as readonly string[]).includes(initial)) initial = 'en';
      apply(initial);
      document
        .querySelectorAll<HTMLElement>('.lang-btn')
        .forEach((b) => b.addEventListener('click', () => setLang(b.dataset.lang || 'en')));
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 30;
        backdrop-filter: blur(14px);
        background: linear-gradient(to bottom, rgba(11, 11, 18, 0.85), rgba(11, 11, 18, 0.4));
        border-bottom: 1px solid var(--border);
      }
      /* Mobile: hide the header until scrolled — the hero is the first thing seen. */
      @media (max-width: 768px) {
        .site-header {
          position: fixed;
          left: 0;
          right: 0;
          transform: translateY(-100%);
          transition: transform 0.35s var(--ease-expo);
          will-change: transform;
        }
        .site-header.revealed {
          transform: translateY(0);
        }
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: 20px;
        height: 68px;
      }
      .lang-switch {
        margin-left: auto;
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--bg-elev);
      }
      .lang-btn {
        padding: 5px 10px;
        border: 0;
        border-radius: 999px;
        background: none;
        color: var(--fg-muted);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        transition: color 0.2s, background 0.2s;
      }
      .lang-btn:hover {
        color: var(--fg);
      }
      .lang-btn.active {
        color: var(--accent-fg);
        background: color-mix(in srgb, var(--accent) 55%, transparent);
      }
      /* roulette roll: the freshly picked language does one full spin */
      .lang-btn.rolling {
        animation: lang-roll 0.5s var(--ease-back);
      }
      @keyframes lang-roll {
        from {
          transform: rotate(0);
        }
        to {
          transform: rotate(360deg);
        }
      }
      .header-cta {
        flex: none;
        padding: 9px 18px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--accent-fg);
        background: var(--brand-gradient);
        box-shadow: 0 6px 20px var(--accent-glow);
        transition: transform 0.2s var(--ease-expo), box-shadow 0.2s;
      }
      .header-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px var(--accent-glow);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        transition: opacity 0.2s;
      }
      /* the compact square MS mark is the header brand on every screen */
      .brand-full {
        display: none;
      }
      .brand:hover {
        opacity: 0.85;
      }
      .crumbs {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: var(--fg-muted);
        overflow-x: auto;
        white-space: nowrap;
      }
      .crumbs a {
        color: var(--fg-muted);
        transition: color 0.2s;
      }
      .crumbs a:hover {
        color: var(--fg);
      }
      .crumbs [aria-current='page'] {
        color: var(--fg);
      }
      .crumbs .sep {
        color: var(--fg-dim);
      }
      main {
        min-height: calc(100vh - 68px - 80px);
      }
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 28px 0;
        margin-top: 80px;
        font-size: 0.85rem;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .footer-li {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--fg-muted);
        font-weight: 500;
        transition: color 0.2s;
      }
      .footer-li:hover {
        color: var(--fg);
      }
      .footer-li svg {
        width: 15px;
        height: 15px;
      }
      .footer-age {
        margin: 12px 0 0;
        font-size: 0.76rem;
        color: var(--fg-dim);
      }
    </style>
  </body>
</html>
