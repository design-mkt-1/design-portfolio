---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { projects } from '../data/projects';
import { url } from '../lib/site';
---

<Base title="Marketing Solutions — Design Portfolio">
  <section class="hero container">
    <div class="hero-logo reveal">
      <img src={url('assets/marketing-solutions-logo.webp')} alt="Marketing Solutions" />
    </div>
    <p class="eyebrow reveal">Design Portfolio</p>
    <h1 class="reveal">Brands we build, <span class="gradient-text">campaigns we ship.</span></h1>
    <p class="lede muted reveal">
      Open any project to see its brand book and the creative we made for it: banners, landing pages, and video.
    </p>
  </section>

  <section class="container">
    <div class="section-head reveal">
      <h2>Projects</h2>
      <span class="count muted">{projects.length} projects</span>
    </div>
    <ProjectGrid />
  </section>
</Base>

<style>
  .hero {
    padding: 72px 24px 40px;
    text-align: center;
    max-width: 820px;
  }
  .hero-logo img {
    height: 84px;
    width: auto;
    margin: 0 auto 30px;
    filter: drop-shadow(0 10px 50px rgba(74, 146, 224, 0.28));
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 14px 0 0;
  }
  .lede {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    margin: 20px auto 0;
    max-width: 560px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 24px 0 22px;
  }
  .section-head h2 {
    font-size: 1.5rem;
  }
  .count {
    font-size: 0.9rem;
  }
</style>
