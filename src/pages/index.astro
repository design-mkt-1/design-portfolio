---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { projects } from '../data/projects';
import { projectBanners, projectLandings } from '../lib/portfolio';
import { url } from '../lib/site';

// Proof numbers, computed from the asset tree at build time so they stay
// current as new work is uploaded — no hand-maintained stats.
const totalLandings = projects.reduce((n, p) => n + projectLandings(p.slug).length, 0);
const totalBanners = projects.reduce((n, p) => n + projectBanners(p.slug).length, 0);
const totalMarkets = new Set(projects.map((p) => p.geo?.code).filter(Boolean)).size;
const stats = [
  { n: projects.length, label: 'brands' },
  { n: totalLandings, label: 'promo landings' },
  { n: totalBanners, label: 'banner sets' },
  { n: totalMarkets, label: 'markets' },
].filter((s) => s.n > 0);
---

<Base
  title="Marketing Solutions — iGaming Creative Studio"
  description="Casino & sportsbook creative: brand systems, promo landings, banners and video for iGaming operators across Romania, Ukraine and worldwide markets."
>
  <section class="hero container">
    <div class="hero-logo reveal">
      <img src={url('assets/marketing-solutions-logo.webp')} alt="Marketing Solutions" />
    </div>
    <p class="eyebrow reveal">iGaming Creative Studio</p>
    <h1 class="reveal">Creative that <span class="gradient-text">converts players.</span></h1>
    <p class="lede muted reveal">
      Brand systems, promo landings, banners and video for casino & sportsbook operators — across Romania, Ukraine and worldwide markets.
    </p>
    <div class="hero-cta reveal">
      <a class="btn btn-primary" href={url('/contact')}>Start a project</a>
      <a class="btn" href="#projects">Browse the work</a>
    </div>
    <div class="stats reveal">
      {
        stats.map((s) => (
          <div class="stat">
            <span class="stat-n">{s.n}</span>
            <span class="stat-l muted">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container" id="projects">
    <div class="section-head reveal">
      <h2>Projects</h2>
      <span class="count muted">{projects.length} projects</span>
    </div>
    <ProjectGrid />
  </section>

  <CtaBanner />
</Base>

<style>
  .hero {
    padding: 72px 24px 48px;
    text-align: center;
    max-width: 860px;
  }
  .hero-logo img {
    height: 84px;
    width: auto;
    margin: 0 auto 30px;
    filter: drop-shadow(0 10px 50px rgba(74, 146, 224, 0.28));
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 14px 0 0;
  }
  .lede {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    margin: 20px auto 0;
    max-width: 620px;
  }
  .hero-cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px 46px;
    margin-top: 40px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 88px;
  }
  .stat-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    line-height: 1.1;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-l {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
  #projects {
    scroll-margin-top: 84px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 24px 0 22px;
  }
  .section-head h2 {
    font-size: 1.5rem;
  }
  .count {
    font-size: 0.9rem;
  }
</style>
