---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import ChoiceCards, { type Choice } from '../../components/ChoiceCards.astro';
import { url } from '../../lib/site';
import { projects, getProject, hasPortfolio, firstSize, landingThumb } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;

// Collect up to 6 real thumbnails for the Portfolio preview (banners → landings → videos).
const portfolioThumbs = [
  ...p.banners.map(firstSize),
  ...p.landings.map(landingThumb),
  ...p.videos.map(firstSize),
].filter((s): s is string => Boolean(s));

// Brand Book cover: auto-detected from disk so it "just works" the moment a
// cover image is uploaded to public/assets/<slug>/brandbook/cover.<ext>.
// Prefers webp; falls back to png/jpg. Until one exists, the card shows the
// brand wordmark on an accent panel instead.
function brandbookCover(slug: string): string | undefined {
  for (const ext of ['webp', 'png', 'jpg', 'jpeg']) {
    const rel = `assets/${slug}/brandbook/cover.${ext}`;
    if (existsSync(join(process.cwd(), 'public', rel))) return rel;
  }
  return undefined;
}

const portfolio = hasPortfolio(p);
const choices: Choice[] = [];
if (p.brandbook) {
  const cover = brandbookCover(p.slug);
  choices.push({
    title: 'Brand Book',
    description: 'Logo, colors, typography, and usage guidelines.',
    href: `/${p.slug}/brandbook`,
    icon: 'book',
    preview: cover ? { type: 'cover', image: cover } : { type: 'brand', logo: p.logo },
  });
}
if (portfolio) {
  choices.push({
    title: 'Portfolio',
    description: 'Banners, landing pages, and video creative.',
    href: `/${p.slug}/portfolio`,
    icon: 'grid',
    preview: portfolioThumbs.length ? { type: 'grid', images: portfolioThumbs.slice(0, 6) } : undefined,
  });
}
---

<Base
  title={`${p.name} — Marketing Solutions`}
  description={p.tagline ? `${p.name} — ${p.tagline}` : `${p.name} on the Marketing Solutions design portfolio.`}
  favicon={p.favicon}
  accent={p.accent}
  crumbs={[{ label: 'Projects', href: '/' }, { label: p.name }]}
>
  <section class="container intro">
    <a class="backlink reveal" href={url('/')}>← All projects</a>
    <div class="head reveal">
      {
        p.favicon ? (
          <img class="icon" src={url(p.favicon)} alt={`${p.name} icon`} />
        ) : (
          <img class="logo" src={url(p.logo)} alt={`${p.name} logo`} />
        )
      }
      <div>
        <h1>{p.name}</h1>
        {p.tagline && <p class="muted lede">{p.tagline}</p>}
      </div>
    </div>
  </section>

  <section class="container">
    <ChoiceCards choices={choices} />
  </section>
</Base>

<style>
  .intro {
    padding-top: 40px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 22px 0 34px;
  }
  .logo {
    height: 76px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
  }
  .icon {
    height: 68px;
    width: 68px;
    object-fit: contain;
    flex: none;
    filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lede {
    font-size: 1.05rem;
    margin: 8px 0 0;
  }
  @media (max-width: 520px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
