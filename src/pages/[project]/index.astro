---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import ChoiceCards, { type Choice } from '../../components/ChoiceCards.astro';
import { url } from '../../lib/site';
import { projects, getProject, firstSize, landingThumb } from '../../data/projects';
import { projectBanners, projectLandings, hasPortfolio, hasBrandbook, assetExists, projectSections, projectOg } from '../../lib/portfolio';
import { thumbFor } from '../../lib/thumbs';
import { readyVideos } from '../../lib/videos';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;

// Collect up to 6 real thumbnails for the Portfolio preview (banners → landings → videos).
const portfolioThumbs = [
  ...projectBanners(p.slug).map(firstSize),
  ...projectLandings(p.slug).map(landingThumb),
  ...readyVideos(p.videos).map((v) => v.poster),
]
  .filter((s): s is string => Boolean(s))
  .map((s) => thumbFor(s)!);

// Brand Book cover: auto-detected from disk. Prefers the first page frame
// (1.webp) so we don't keep a duplicate cover image; falls back to an explicit
// cover.<ext>, and finally to the brand wordmark panel when nothing exists.
function brandbookCover(slug: string): string | undefined {
  const dir = join(process.cwd(), 'public', 'assets', slug, 'brandbook');
  if (!existsSync(dir)) return undefined;
  const firstFrame = readdirSync(dir)
    .filter((f) => /^\d+\.(webp|png|jpe?g)$/i.test(f))
    .sort((a, b) => parseInt(a, 10) - parseInt(b, 10))[0];
  if (firstFrame) return `assets/${slug}/brandbook/${firstFrame}`;
  for (const ext of ['webp', 'png', 'jpg', 'jpeg']) {
    if (existsSync(join(dir, `cover.${ext}`))) return `assets/${slug}/brandbook/cover.${ext}`;
  }
  return undefined;
}

// Header art: prefer the brand icon, then the logo, then a text wordmark — so a
// project whose assets haven't been uploaded yet still renders cleanly.
const headerIcon = p.favicon && assetExists(p.favicon) ? p.favicon : undefined;
const headerLogo = !headerIcon && assetExists(p.logo) ? p.logo : undefined;

const portfolio = hasPortfolio(p);
const choices: Choice[] = [];
if (hasBrandbook(p)) {
  const cover = brandbookCover(p.slug);
  // Fall back to the brand panel only when a logo exists; otherwise leave the
  // preview off so the card shows its book-icon placeholder (no broken image).
  const preview = cover
    ? ({ type: 'cover', image: thumbFor(cover)! } as const)
    : assetExists(p.logo)
      ? ({ type: 'brand', logo: p.logo } as const)
      : undefined;
  choices.push({
    title: 'Brand Book',
    description: 'Logo, colors, typography, and usage guidelines.',
    href: `/${p.slug}/brandbook`,
    icon: 'book',
    preview,
  });
}
if (portfolio) {
  choices.push({
    title: 'Portfolio',
    description: 'Banners, landing pages, and video creative.',
    href: `/${p.slug}/portfolio`,
    icon: 'grid',
    preview: portfolioThumbs.length ? { type: 'grid', images: portfolioThumbs.slice(0, 6) } : undefined,
  });
}

// If the project has exactly one section, skip this chooser and open it directly.
// (A static redirect page — instant via JS, meta-refresh fallback for no-JS.)
const sections = projectSections(p);
const only = sections.length === 1 ? sections[0] : null;
const redirectTo = only ? url(`/${p.slug}/${only}`) : null;
---

{
  redirectTo ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
        <link rel="canonical" href={redirectTo} />
        <meta name="robots" content="noindex" />
        <title>{p.name} — Marketing Solutions</title>
        <script is:inline set:html={`location.replace(${JSON.stringify(redirectTo)})`} />
      </head>
      <body>
        <a href={redirectTo}>Continue to {p.name} →</a>
      </body>
    </html>
  ) : (
    <Base
      title={`${p.name} — Marketing Solutions`}
      description={p.tagline ? `${p.name} — ${p.tagline}` : `${p.name} on the Marketing Solutions design portfolio.`}
      favicon={p.favicon}
  ogImage={projectOg(p)}
      accent={p.accent}
      crumbs={[{ label: 'Projects', href: '/' }, { label: p.name }]}
    >
  <section class="container intro">
    <a class="backlink reveal" href={url('/')}>← All projects</a>
    <div class="head reveal">
      {
        headerIcon ? (
          <img class="icon" src={url(headerIcon)} alt={`${p.name} icon`} />
        ) : headerLogo ? (
          <img class="logo" src={url(headerLogo)} alt={`${p.name} logo`} />
        ) : (
          <span class="wordmark">{p.name}</span>
        )
      }
      <div>
        <h1>{p.name}</h1>
        {p.tagline && <p class="muted lede">{p.tagline}</p>}
      </div>
    </div>
  </section>

  <section class="container">
    {
      choices.length > 0 ? (
        <ChoiceCards choices={choices} />
      ) : (
        <p class="empty muted reveal">Brand book and creative are coming soon.</p>
      )
    }
  </section>
    </Base>
  )
}

<style>
  .intro {
    padding-top: 40px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 22px 0 34px;
  }
  .logo {
    height: 76px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
  }
  .icon {
    height: 68px;
    width: 68px;
    object-fit: contain;
    flex: none;
    filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: color-mix(in srgb, var(--accent) 70%, var(--fg));
    flex: none;
  }
  .empty {
    padding: 8px 0 40px;
    font-size: 1.02rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lede {
    font-size: 1.05rem;
    margin: 8px 0 0;
  }
  @media (max-width: 520px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
