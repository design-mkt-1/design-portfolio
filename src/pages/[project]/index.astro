---
import Base from '../../layouts/Base.astro';
import ChoiceCards, { type Choice } from '../../components/ChoiceCards.astro';
import { url } from '../../lib/site';
import { projects, getProject, hasPortfolio } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;

const portfolio = hasPortfolio(p);
const choices: Choice[] = [];
if (p.brandbook) {
  choices.push({
    title: 'Brand Book',
    description: 'Logo, colors, typography, and usage guidelines.',
    href: `/${p.slug}/brandbook`,
    icon: 'book',
  });
}
if (portfolio) {
  choices.push({
    title: 'Portfolio',
    description: 'Banners, landing pages, and video creative.',
    href: `/${p.slug}/portfolio`,
    icon: 'grid',
  });
}
---

<Base
  title={`${p.name} — Marketing Solutions`}
  crumbs={[{ label: 'Projects', href: '/' }, { label: p.name }]}
>
  <section class="container intro">
    <a class="backlink reveal" href={url('/')}>← All projects</a>
    <div class="head reveal">
      <img class="logo" src={url(p.logo)} alt={`${p.name} logo`} />
      <div>
        <h1>{p.name}</h1>
        {p.tagline && <p class="muted lede">{p.tagline}</p>}
      </div>
    </div>
  </section>

  <section class="container">
    <ChoiceCards choices={choices} />
  </section>
</Base>

<style>
  .intro {
    padding-top: 40px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 22px 0 34px;
  }
  .logo {
    height: 76px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lede {
    font-size: 1.05rem;
    margin: 8px 0 0;
  }
  @media (max-width: 520px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
