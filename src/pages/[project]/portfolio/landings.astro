---
import Base from '../../../layouts/Base.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import LandingsGallery from '../../../components/LandingsGallery.astro';
import { url } from '../../../lib/site';
import { projects, getProject } from '../../../data/projects';
import { projectLandings, projectCrumb } from '../../../lib/portfolio';

export function getStaticPaths() {
  return projects.filter((p) => projectLandings(p.slug).length > 0).map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;
const landings = projectLandings(p.slug);
---

<Base
  title={`${p.name} Landings — Marketing Solutions`}
  description={`${p.name} landing page designs — mobile and desktop.`}
  favicon={p.favicon}
  accent={p.accent}
  crumbs={[
    { label: 'Projects', href: '/' },
    projectCrumb(p),
    { label: 'Portfolio', href: `/${p.slug}/portfolio` },
    { label: 'Landings' },
  ]}
>
  <section class="container head">
    <a class="backlink reveal" href={url(`/${p.slug}/portfolio`)}>← Portfolio</a>
    <h1 class="reveal">{p.name} <span class="muted">Landings</span></h1>
    <p class="lede muted reveal">Mobile-first. Tap any landing to view it full-length and switch between mobile and desktop.</p>
  </section>

  <section class="container">
    <LandingsGallery items={landings} alt={p.name} />
  </section>
  <CtaBanner />
</Base>

<style>
  .head {
    padding-top: 40px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    margin: 18px 0 6px;
  }
  .lede {
    font-size: 1.02rem;
  }
</style>
