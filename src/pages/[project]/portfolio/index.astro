---
import Base from '../../../layouts/Base.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import ChoiceCards, { type Choice } from '../../../components/ChoiceCards.astro';
import { url } from '../../../lib/site';
import { projects, getProject, firstSize } from '../../../data/projects';
import { projectBanners, projectLandings, hasPortfolio, projectCrumb, sectionBack, projectOg } from '../../../lib/portfolio';
import { readyVideos } from '../../../lib/videos';
import { storeCount, allStoreImages, storeTitle } from '../../../lib/store';
import { thumbFor } from '../../../lib/thumbs';

export function getStaticPaths() {
  return projects.filter(hasPortfolio).map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;
const banners = projectBanners(p.slug);
const landings = projectLandings(p.slug);
const videos = readyVideos(p.videos);
const storeImages = allStoreImages(p.slug);

// Real thumbnails per format for the card previews.
const bannerThumbs = banners.map(firstSize).filter((s): s is string => !!s).map((s) => thumbFor(s)!); // 1:1 squares
const landingThumbs = landings.map((l) => l.desktop ?? l.mobile).filter((s): s is string => !!s).map((s) => thumbFor(s)!);
const videoThumbs = videos.map((v) => v.poster).filter((s): s is string => !!s).map((s) => thumbFor(s)!);

// 6+ thumbnails → 3×2 mosaic; 1–5 → single cover; none → fall back to the icon.
function preview(thumbs: string[]): Choice['preview'] {
  if (thumbs.length >= 6) return { type: 'grid', images: thumbs.slice(0, 6) };
  if (thumbs.length) return { type: 'cover', image: thumbs[0] };
  return undefined;
}

// Formats appear only once they have content — an empty greyed-out card reads
// as unfinished on a partner-facing site. Upload assets and the card shows up.
const choices: Choice[] = [];
if (banners.length > 0) {
  choices.push({
    title: 'Banners',
    description: 'Static creative in every placement size.',
    href: `/${p.slug}/portfolio/banners`,
    icon: 'image',
    meta: `${banners.length}`,
    preview: preview(bannerThumbs),
  });
}
if (landings.length > 0) {
  choices.push({
    title: 'Landings',
    description: 'Landing page designs.',
    href: `/${p.slug}/portfolio/landings`,
    icon: 'layout',
    meta: `${landings.length}`,
    preview: preview(landingThumbs),
  });
}
if (videos.length > 0) {
  choices.push({
    title: 'Videos',
    description: 'Motion and video creative.',
    href: `/${p.slug}/portfolio/videos`,
    icon: 'film',
    meta: `${videos.length}`,
    preview: preview(videoThumbs),
  });
}
if (storeImages.length > 0) {
  choices.push({
    title: storeTitle(p.slug),
    description: 'Store listing creative.',
    href: `/${p.slug}/portfolio/store`,
    icon: 'store',
    meta: `${storeCount(p.slug)}`,
    preview: { type: 'carousel', images: storeImages.map((s) => thumbFor(s)!) },
  });
}
---

<Base
  title={`${p.name} Portfolio — Marketing Solutions`}
  description={`${p.name} creative portfolio — banners, landing pages, and video.`}
  favicon={p.favicon}
  ogImage={projectOg(p)}
  accent={p.accent}
  crumbs={[{ label: 'Projects', href: '/' }, projectCrumb(p), { label: 'Portfolio' }]}
>
  <section class="container head">
    <a class="backlink reveal" href={url(sectionBack(p).href)}>← {sectionBack(p).label}</a>
    <h1 class="reveal">{p.name} <span class="muted">Portfolio</span></h1>
    <p class="lede muted reveal">Choose a format to browse the creative.</p>
  </section>

  <section class="container">
    <ChoiceCards choices={choices} />
  </section>
  <CtaBanner />
</Base>

<style>
  .head {
    padding-top: 40px;
    margin-bottom: 30px;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    margin: 18px 0 6px;
  }
  .lede {
    font-size: 1.05rem;
  }
</style>
