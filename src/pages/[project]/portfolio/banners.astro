---
import Base from '../../../layouts/Base.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import MediaGallery from '../../../components/MediaGallery.astro';
import { url } from '../../../lib/site';
import { projects, getProject } from '../../../data/projects';
import { projectBanners, projectCrumb, formatBack, portfolioCrumb, projectOg } from '../../../lib/portfolio';

export function getStaticPaths() {
  return projects.filter((p) => projectBanners(p.slug).length > 0).map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;
const banners = projectBanners(p.slug);
---

<Base
  title={`${p.name} Banners — Marketing Solutions`}
  description={`${p.name} banner creative in every placement size.`}
  favicon={p.favicon}
  ogImage={projectOg(p)}
  accent={p.accent}
  crumbs={[
    { label: 'Projects', href: '/' },
    projectCrumb(p),
    portfolioCrumb(p),
    { label: 'Banners' },
  ]}
>
  <section class="container head">
    <a class="backlink reveal" href={url(formatBack(p).href)}>← {formatBack(p).label}</a>
    <h1 class="reveal">{p.name} <span class="h1-sep" aria-hidden="true">/</span> <span class="muted">Banners</span></h1>
    <p class="lede muted reveal">Each tile is the 1080×1080. Open one to see every size.</p>
  </section>

  <section class="container">
    <MediaGallery items={banners} kind="banner" />
  </section>
  <CtaBanner />
</Base>

<style>
  .head {
    padding-top: 40px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    margin: 18px 0 6px;
  }
  .lede {
    font-size: 1.02rem;
  }
</style>
