---
import Base from '../../../layouts/Base.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import StoreGallery from '../../../components/StoreGallery.astro';
import { url } from '../../../lib/site';
import { projects, getProject } from '../../../data/projects';
import { storeGroups, hasStore, storeTitle } from '../../../lib/store';
import { projectCrumb, formatBack, portfolioCrumb, projectOg } from '../../../lib/portfolio';

export function getStaticPaths() {
  return projects.filter((p) => hasStore(p.slug)).map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;
const groups = storeGroups(p.slug);
const title = storeTitle(p.slug);
---

<Base
  title={`${p.name} ${title} — Marketing Solutions`}
  description={`${p.name} ${title} store creative.`}
  favicon={p.favicon}
  ogImage={projectOg(p)}
  accent={p.accent}
  crumbs={[
    { label: 'Projects', href: '/' },
    projectCrumb(p),
    portfolioCrumb(p),
    { label: title },
  ]}
>
  <section class="container head">
    <a class="backlink reveal" href={url(formatBack(p).href)}>← {formatBack(p).label}</a>
    <h1 class="reveal">{p.name} <span class="h1-sep" aria-hidden="true">/</span> <span class="muted">{title}</span></h1>
    <p class="lede muted reveal">Store listing creative. Tap a screenshot to view it full-size.</p>
  </section>

  <section class="container">
    <StoreGallery groups={groups} alt={p.name} />
  </section>
  <CtaBanner />
</Base>

<style>
  .head {
    padding-top: 40px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    margin: 18px 0 6px;
  }
  .lede {
    font-size: 1.02rem;
  }
</style>
