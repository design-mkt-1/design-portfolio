---
import Base from '../../../layouts/Base.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import VideoGallery from '../../../components/VideoGallery.astro';
import { url } from '../../../lib/site';
import { projects, getProject } from '../../../data/projects';
import { readyVideos } from '../../../lib/videos';
import { projectCrumb, projectOg } from '../../../lib/portfolio';

export function getStaticPaths() {
  return projects.filter((p) => readyVideos(p.videos).length > 0).map((p) => ({ params: { project: p.slug } }));
}

const { project } = Astro.params;
const p = getProject(project!)!;
const videos = readyVideos(p.videos);
---

<Base
  title={`${p.name} Videos — Marketing Solutions`}
  description={`${p.name} video and motion creative.`}
  favicon={p.favicon}
  ogImage={projectOg(p)}
  accent={p.accent}
  crumbs={[
    { label: 'Projects', href: '/' },
    projectCrumb(p),
    { label: 'Portfolio', href: `/${p.slug}/portfolio` },
    { label: 'Videos' },
  ]}
>
  <section class="container head">
    <a class="backlink reveal" href={url(`/${p.slug}/portfolio`)}>← Portfolio</a>
    <h1 class="reveal">{p.name} <span class="muted">Videos</span></h1>
    <p class="lede muted reveal">Tap a video to play it.</p>
  </section>

  <section class="container">
    <VideoGallery items={videos} />
  </section>
  <CtaBanner />
</Base>

<style>
  .head {
    padding-top: 40px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    margin: 18px 0 6px;
  }
  .lede {
    font-size: 1.02rem;
  }
</style>
